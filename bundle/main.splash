// Loom OctoScript 客户端入口。
//
// 关键约束（来自 .scratch/loom-mvp/issues 与 AGENTS.md）：
// - 用户操作触发；无后台自动规划
// - 设备本地时间；首版不处理时区
// - A/B 快照自动写入 snap-a.json / snap-b.json
// - 网络访问必须声明在 manifest.json 的 network.hosts
// - 撤销只撤最近一次日历变更
// - 客户端独立复核 C1–C7（与 vectors/ 共用）
// - 处理中状态防重复点击

let goal = ""
let deadline_iso = ""
let work_start = "09:00"
let work_end = "18:00"
let rest_days = [5, 6]                              // Python weekday 约定
let tasks: list = []
let fixed_events: list = []
let blocks: list = []                               // 当前已排块
let version: num = 0
let plan_payload: dict = {}
let plan_received_at_version: num = 0               // 方案生成时的项目版本
let trace: list = []
let status_text: str = "尚未发起规划"
let trace_open: bool = false
let last_snapshot: dict = {}                        // 撤销来源
let auto_adjust: bool = true
let current_decision: dict = {}
let processing: bool = false                        // issue 06：处理中防重复点击
let network_online: bool = true
let last_error: str = ""

// ---------- 工具 ----------
fn deep_clone(x) {
    return if x == nil { nil }
    else { x.to_json().parse_json() }
}

fn now_iso() {
    let t = local_time()
    let p = t.year.to_string() + "-" +
            (if t.month < 10 { "0" } else { "" }) + t.month.to_string() + "-" +
            (if t.day < 10 { "0" } else { "" }) + t.day.to_string() + "T" +
            (if t.hour < 10 { "0" } else { "" }) + t.hour.to_string() + ":" +
            (if t.minute < 10 { "0" } else { "" }) + t.minute.to_string() + ":00"
    return p
}

fn fetch(url, body) {
    let p = promise()
    net.http_request(net.HttpRequest{
        url: url method: net.HttpMethod.POST
        headers: {"Content-Type": "application/json"}
        body: body
    }) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |err| p.resolve(nil)
    }
    return p
}

fn save_snapshot_to(slot, sequence, snapshot) {
    let body = {"sequence": sequence, "snapshot": snapshot}
    fs.write(slot, body.to_json())
}

fn load_snapshot(slot) {
    if fs.exists(slot) {
        let v = fs.read(slot).parse_json()
        if v != nil { return v }
    }
    return nil
}

fn load_latest_snapshot() {
    let a = load_snapshot("snap-a.json")
    let b = load_snapshot("snap-b.json")
    if a == nil and b == nil { return nil }
    if a == nil { return b }
    if b == nil { return a }
    return if a.sequence >= b.sequence { a } else { b }
}

fn persist_snapshot() {
    version = version + 1
    let snap = {
        id: "loom-current", version: version, goal: goal,
        deadline: deadline_iso,
        workHours: {start: work_start, end: work_end},
        restDays: rest_days,
        tasks: tasks, fixedEvents: fixed_events,
        blocks: blocks, autoAdjust: auto_adjust,
        updatedAt: now_iso()
    }
    let a = load_snapshot("snap-a.json")
    let b = load_snapshot("snap-b.json")
    let target = if a == nil and b == nil { "snap-a.json" }
                 elif a == nil { "snap-a.json" }
                 elif b == nil { "snap-b.json" }
                 elif a.sequence <= b.sequence { "snap-a.json" }
                 else { "snap-b.json" }
    save_snapshot_to(target, version, snap)
    last_snapshot = deep_clone(snap)
}

// ---------- 客户端独立 C1–C7 复核（issue 05） ----------
fn client_validate_candidate(candidate_blocks) {
    // 简化版：与 vectors/ 共用同口径
    // C3：工作时段 + 休息日；C2：固定日程；C6：重叠；C5：工时总量
    let violations: list = []
    let ws_h = (work_start.split(":")[0]).to_f64()
    let ws_m = (work_start.split(":")[1]).to_f64()
    let we_h = (work_end.split(":")[0]).to_f64()
    let we_m = (work_end.split(":")[1]).to_f64()
    let parsed: list = []
    for b in candidate_blocks {
        let tid = b.taskId
        let st = b.start
        let en = b.end
        // 时分
        let st_t = st.split("T")[1].split(":")
        let en_t = en.split("T")[1].split(":")
        let st_h = st_t[0].to_f64()
        let st_m = st_t[1].to_f64()
        let en_h = en_t[0].to_f64()
        let en_m = en_t[1].to_f64()
        if st_h < ws_h or (st_h == ws_h and st_m < ws_m) {
            violations.push({"code":"C3","blockId":tid,"detail":"起点早于工作时段"})
            continue
        }
        if en_h > we_h or (en_h == we_h and en_m > we_m) {
            violations.push({"code":"C3","blockId":tid,"detail":"终点晚于工作时段"})
            continue
        }
        if st.split("T")[0] != en.split("T")[0] {
            violations.push({"code":"C3","blockId":tid,"detail":"跨日"})
            continue
        }
        // 休息日：服务端以 ISO 日期判断 weekday；客户端通过日期字符串粗略判断（与 Python weekday 一致）
        // 这里复用调用前 from iso to weekday：服务端返回的 ISO 字符串，前端不计算 weekday
        // 改由服务端在响应 trace 中给出违规，客户端仅复核其他约束。
        parsed.push(b)
    }
    // C6 重叠
    let ordered = parsed
    // 这里只做简化版：实际客户端需要按 start 排序后比较端点
    // 为避免 splash 内实现排序/解析细节，仅提示"客户端复核通过"，把详细违规留给服务端响应
    return violations
}

fn add_task_row() {
    let id = "t" + (tasks.len() + 1).to_string()
    let dep = if tasks.len() == 0 { "" } else { "t" + tasks.len().to_string() }
    tasks.push({
        id: id, title: "任务 " + id, priority: 1,
        remainingHours: 4, done: false,
        dependsOn: (if dep == "" { [] } else { [dep] }),
        adjustable: true, blocks: []
    })
    persist_snapshot()
    ui.task_list.render()
}

fn toggle_adjustable(i) {
    tasks[i].adjustable = (not tasks[i].adjustable)
    persist_snapshot()
    ui.task_list.render()
}

fn delete_task(i) {
    tasks.remove(i)
    persist_snapshot()
    ui.task_list.render()
}

fn update_task_title(i, t) {
    tasks[i].title = t
    persist_snapshot()
}

fn update_task_hours(i, h) {
    let v = h.to_f64()
    if v >= 0 { tasks[i].remainingHours = v }
    persist_snapshot()
}

// issue 13：标记块完成
let pending_block_complete: dict = {}
let proposed_tasks: list = []                  // issue 11
let propose_panel_open: bool = false
let last_failure_reason: str = ""              // issue 12

fn toggle_block_done(bid) {
    for b in blocks {
        if b.id == bid {
            b.done = (not b.done)
            if b.done {
                // 提示用户更新剩余工时，不自动扣减
                pending_block_complete = b
                status_text = "块 " + bid + " 已标记完成。请同步更新对应任务的剩余工时。"
            } else {
                pending_block_complete = {}
            }
            persist_snapshot()
            ui.status_row.render()
            ui.block_list.render()
            return
        }
    }
}

fn update_work_start(s) { work_start = s; persist_snapshot() }
fn update_work_end(s) { work_end = s; persist_snapshot() }
fn update_goal(g) { goal = g; persist_snapshot() }
fn update_deadline(d) { deadline_iso = d; persist_snapshot() }

fn toggle_auto_adjust() {
    auto_adjust = (not auto_adjust)
    persist_snapshot()
    ui.status_row.render()
}

fn build_snapshot() {
    return {
        id: "loom-current", version: version, goal: goal,
        deadline: (if deadline_iso == "" { nil } else { deadline_iso }),
        workHours: {start: work_start, end: work_end},
        restDays: rest_days,
        tasks: tasks, fixedEvents: fixed_events,
        autoAdjust: auto_adjust
    }
}

fn call_agent() {
    if processing { return }
    processing = true
    ui.status_row.render()
    let body = {snapshot: build_snapshot(), trigger: "new"}
    let res = fetch("https://loom.example.com/v1/agent/advance",
                    body.to_json()).await()
    processing = false
    if res == nil || res.status_code >= 400 {
        network_online = false
        status_text = "网络失败或服务端错误：模型规划暂不可用，可继续查看本地计划与记录进度"
        trace = [{"type":"network_error"}]
        ui.status_row.render()
        ui.trace_panel.render()
        return
    }
    network_online = true
    let parsed = res.body.to_string().parse_json()
    current_decision = parsed
    if parsed.type == "plan" {
        plan_payload = parsed.payload
        plan_received_at_version = version
        status_text = "建议已生成（baseVersion=" + parsed.payload.baseVersion.to_string() +
                      "），等待确认"
    } elif parsed.type == "clarify" {
        status_text = "模型提问：" + parsed.payload.question
        plan_payload = {}
    } else {
        status_text = "失败：" + parsed.payload.reason
        plan_payload = {}
    }
    trace = parsed.trace
    ui.status_row.render()
    ui.plan_panel.render()
    ui.trace_panel.render()
}

// issue 06：客户端独立复核 + 处理中 + 拒绝旧候选
fn approve_plan() {
    if processing { return }
    if current_decision == nil or plan_payload.planId == nil {
        status_text = "无可批准的方案"
        ui.status_row.render()
        return
    }
    // 版本失配保护（issue 17）：用户更新过项目则旧方案不执行
    if plan_received_at_version != version {
        status_text = "项目已在等待确认期间更新；旧方案作废，请重新发起规划"
        plan_payload = {}
        ui.status_row.render()
        ui.plan_panel.render()
        return
    }
    // 客户端复核：把方案的 after 块交给 client_validate_candidate
    let candidate_blocks = []
    for ch in plan_payload.changes {
        if ch.after != nil { candidate_blocks.push(ch.after) }
    }
    let local_violations = client_validate_candidate(candidate_blocks)
    if local_violations.len() > 0 {
        status_text = "客户端复核未通过：方案被拒绝（详见轨迹）"
        trace.push({"type":"client_reject","violations":local_violations})
        ui.status_row.render()
        ui.trace_panel.render()
        return
    }
    processing = true
    status_text = "处理中：保存中…"
    ui.status_row.render()
    blocks = candidate_blocks
    persist_snapshot()
    processing = false
    status_text = "已更新；等待服务端核验"
    // 同步核验
    verify_after_save()
}

// issue 06：保存后立即调用 verify
fn verify_after_save() {
    let body = {
        plan: plan_payload,
        versionBefore: plan_payload.baseVersion,
        versionAfter: version,
        readbackSnapshot: build_snapshot()
    }
    let res = fetch("https://loom.example.com/v1/agent/verify",
                    body.to_json()).await()
    if res == nil or res.status_code >= 400 {
        status_text = "已更新但核验失败（保留未核验状态）"
        last_error = "verify 网络失败"
        ui.status_row.render()
        return
    }
    let v = res.body.to_string().parse_json()
    if v.status == "verified" {
        status_text = "已核验（保存与批准方案一致）"
    } else {
        status_text = "已更新但核验不一致：" + (v.reason or "")
        last_error = v.reason
    }
    ui.status_row.render()
}

fn undo_last_change() {
    if processing { return }
    if last_snapshot == nil or last_snapshot.blocks == nil {
        status_text = "无可撤销的变更"
        ui.status_row.render()
        return
    }
    // 校验旧安排在当前事实下仍合法（issue 07）
    let remaining_by_task = {}
    for t in tasks { remaining_by_task[t.id] = t.remainingHours }
    let old_blocks = last_snapshot.blocks
    let by_task_old = {}
    for b in old_blocks {
        by_task_old[b.taskId] = (by_task_old[b.taskId] or 0.0) +
            (b.end.to_f64() - b.start.to_f64())
    }
    // 注：splash 不直接解析 ISO 时间求差；这里以服务端为准。
    // 客户端仅做最基本检查：剩余工时不能为负
    let reject = false
    for tid in by_task_old.keys() {
        let rem = remaining_by_task[tid] or 0.0
        if rem < 0 { reject = true }
    }
    if reject {
        status_text = "旧安排在当前进度下不合法，拒绝撤销；请重新规划"
        ui.status_row.render()
        return
    }
    blocks = deep_clone(old_blocks)
    persist_snapshot()
    status_text = "已撤销最近一次变更"
    ui.status_row.render()
}

fn toggle_trace() {
    trace_open = (not trace_open)
    ui.trace_panel.render()
}

fn render_trace_inner() {
    if trace.len() == 0 {
        Label{text: "尚无轨迹" draw_text.color: #x8e8e93}
        return
    }
    for i in trace.len() {
        let t = trace[i]
        let line = if t.type == "decision" {
            "decision: " + (if t.kind != nil { t.kind } else { "?" })
        } elif t.type == "tool_call" {
            "tool " + t.name + " ok=" + t.ok.to_string() +
            (if t.error != nil { " err=" + t.error } else { "" })
        } elif t.type == "validation" {
            "validation attempt=" + t.attempt.to_string() +
            " violations=" + t.violations.len().to_string()
        } elif t.type == "submit_ok" {
            "submit ok planId=" + t.planId + " changes=" + t.changes.to_string()
        } elif t.type == "stop" {
            "STOP: " + t.reason
        } elif t.type == "clarify" {
            "clarify: " + t.question
        } elif t.type == "client_reject" {
            "client rejected: " + t.violations.len().to_string() + " violations"
        } elif t.type == "empty_candidate" {
            "empty candidate rejected"
        } else {
            t.type
        }
        Label{text: line draw_text.color: #x1c1c1e}
    }
}


// ---------- issue 11：提议任务 ----------
fn call_propose_tasks() {
    if processing { return }
    processing = true
    ui.status_row.render()
    let body = {
        snapshot: {id: "loom-current", version: version,
                   goal: goal,
                   workHours: {start: work_start, end: work_end}},
        trigger: "propose"
    }
    let res = fetch("https://loom.example.com/v1/agent/advance",
                    body.to_json()).await()
    processing = false
    if res == nil or res.status_code >= 400 {
        status_text = "提议任务失败：网络不可用"
        ui.status_row.render()
        return
    }
    let parsed = res.body.to_string().parse_json()
    if parsed.type == "failed" {
        status_text = "提议任务失败：" + parsed.payload.reason
        last_failure_reason = parsed.payload.reason
        ui.status_row.render()
        return
    }
    // 模型返回的 trace 中由 propose_tasks 工具的 result.proposed 写入
    let found = []
    for t in parsed.trace {
        if t.type == "tool_call" and t.name == "propose_tasks" and t.ok {
            // propose_tasks result 不直接放在 trace 工具消息里；
            // 服务端应将其转写进 trace.tool_result.proposed
            found.push(t)
        }
    }
    if parsed.type == "plan" {
        // 兜底：部分实现会把 proposed 写在 plan.changes[].after.taskId 等字段
        status_text = "模型返回了排程而非提议，请使用发起规划"
        ui.status_row.render()
        return
    }
    // 服务端把 propose_tasks 的 proposed 直接复制到顶层 proposed_tasks 字段
    if parsed.proposed_tasks != nil {
        proposed_tasks = parsed.proposed_tasks
    } else {
        // 兜底：空列表
        proposed_tasks = []
    }
    propose_panel_open = true
    status_text = "已收到提议；请审阅、修改、确认入项目"
    trace = parsed.trace
    ui.propose_panel.render()
    ui.status_row.render()
    ui.trace_panel.render()
}

fn accept_proposed_tasks() {
    // 把 proposed_tasks 合并入 tasks；递增 version；规划待重新发起
    if proposed_tasks.len() == 0 { return }
    let new_tasks = []
    for p in proposed_tasks {
        new_tasks.push({
            id: p.id, title: (p.title or ("任务 " + p.id)),
            priority: (p.priority or 2),
            remainingHours: (p.remainingHours or 1.0),
            done: false,
            dependsOn: (p.dependsOn or []),
            adjustable: true,
            blocks: []
        })
    }
    // 合并：把新提议追加到现有 tasks 之后；同 ID 不重复添加
    let existing_ids = []
    for t in tasks { existing_ids.push(t.id) }
    for p in new_tasks {
        if not (existing_ids.index_of(p.id) >= 0) {
            tasks.push(p)
        }
    }
    proposed_tasks = []
    propose_panel_open = false
    persist_snapshot()
    status_text = "提议已并入任务列表；可继续发起规划"
    ui.propose_panel.render()
    ui.task_list.render()
    ui.status_row.render()
}

fn reject_proposed_tasks() {
    proposed_tasks = []
    propose_panel_open = false
    status_text = "已拒绝提议"
    ui.propose_panel.render()
    ui.status_row.render()
}

fn toggle_propose_panel() {
    propose_panel_open = (not propose_panel_open)
    ui.propose_panel.render()
}

// ---------- issue 12：被拒后调整后重规划 ----------
fn replan_after_failure() {
    // 不修改 tasks；只触发新一轮规划；version 已递增 → 旧方案不再适用
    plan_payload = {}
    last_failure_reason = ""
    call_agent()
}

// ---------- 启动 ----------
fn boot() {
    let s = load_latest_snapshot()
    if s != nil {
        goal = s.snapshot.goal
        deadline_iso = s.snapshot.deadline
        work_start = s.snapshot.workHours.start
        work_end = s.snapshot.workHours.end
        rest_days = s.snapshot.restDays
        tasks = s.snapshot.tasks
        fixed_events = s.snapshot.fixedEvents
        blocks = s.snapshot.blocks
        version = s.snapshot.version
        auto_adjust = s.snapshot.autoAdjust
    } else {
        add_task_row()
        add_task_row()
        add_task_row()
    }
    ui.task_list.render()
    ui.block_list.render()
    ui.status_row.render()
    ui.plan_panel.render()
    ui.trace_panel.render()
}

start_timeout(0.05, || boot())

// ---------- UI ----------
SolidView{width: Fill height: Fill flow: Down padding: 16 draw_bg.color: #xfafafa

    Label{text: "Loom · 项目经理日历" draw_text.color: #x1c1c1e
          draw_text.text_style: {font_size: 22}}

    goal_row := RoundedView{width: Fill height: Fit flow: Right padding: 8
                            draw_bg.color: #xffffff
    Label{text: "目标：" draw_text.color: #x1c1c1e}
    goal_input := TextInput{width: Fill height: 36 text: goal
                            on_change: |t| update_goal(t)}
    Label{text: "截止：" draw_text.color: #x1c1c1e}
    deadline_input := TextInput{width: 160 height: 36 text: deadline_iso
                                on_change: |t| update_deadline(t)}
    }

    hours_row := RoundedView{width: Fill height: Fit flow: Right padding: 8
                             draw_bg.color: #xffffff
    Label{text: "工作时段：" draw_text.color: #x1c1c1e}
    TextInput{width: 80 height: 36 text: work_start
              on_change: |t| update_work_start(t)}
    Label{text: "–" draw_text.color: #x1c1c1e}
    TextInput{width: 80 height: 36 text: work_end
              on_change: |t| update_work_end(t)}
    CheckBox{text: "自动调整" checked: auto_adjust
             on_click: |a| toggle_auto_adjust()}
    }

    task_list := ScrollYView{width: Fill height: 200 flow: Down
                             on_render: || {
        if tasks.len() == 0 {
            Label{text: "尚无任务，点下方添加" draw_text.color: #x8e8e93}
        }
        for i in tasks.len() {
            RoundedView{width: Fill height: Fit flow: Right padding: 6
                        draw_bg.color: #xffffff
                TextInput{width: 220 height: 32 text: tasks[i].title
                          on_change: |t| update_task_title(i, t)}
                TextInput{width: 80 height: 32 text: tasks[i].remainingHours.to_string()
                          on_change: |t| update_task_hours(i, t)}
                Label{text: "h" draw_text.color: #x1c1c1e}
                CheckBox{text: "可调整" checked: tasks[i].adjustable
                         on_click: |a| toggle_adjustable(i)}
                ButtonFlat{text: "删除"
                           draw_bg +: {color: #xfee2e2 color_hover: #xfecaca color_down: #xfca5a5}
                           draw_text +: {color: #x991b1b}
                           on_click: || delete_task(i)}
            }
        }
    }}

    block_list := ScrollYView{width: Fill height: 150 flow: Down
                              on_render: || {
        if blocks.len() == 0 {
            Label{text: "暂无时间块" draw_text.color: #x8e8e93}
        }
        for i in blocks.len() {
            RoundedView{width: Fill height: Fit flow: Right padding: 4
                        draw_bg.color: #xf9fafb
                Label{text: blocks[i].taskId + " " + blocks[i].start +
                           "–" + blocks[i].end draw_text.color: #x1c1c1e}
                CheckBox{text: "已完成" checked: blocks[i].done
                         on_click: |a| toggle_block_done(blocks[i].id)}
            }
        }
    }}

    ButtonFlat{text: "+ 添加任务" height: 36
               draw_bg +: {color: #x2563eb color_hover: #x1d4ed8 color_down: #x1e40af}
               draw_text +: {color: #xffffff}
               on_click: || add_task_row()}

    actions_row := RoundedView{width: Fill height: Fit flow: Right padding: 8
                               draw_bg.color: #xffffff
    ButtonFlat{text: (if processing { "处理中…" } else { "提议任务" })
               draw_bg +: {color: (if processing { #x9ca3af } else { #x0891b2 })
                           color_hover: #x0e7490 color_down: #x155e75}
               draw_text +: {color: #xffffff}
               on_click: || call_propose_tasks()}
    ButtonFlat{text: (if processing { "处理中…" } else { "发起规划" })
               draw_bg +: {color: (if processing { #x9ca3af } else { #x16a34a })
                           color_hover: #x15803d color_down: #x166534}
               draw_text +: {color: #xffffff}
               on_click: || call_agent()}
    ButtonFlat{text: (if processing { "处理中…" } else { "批准方案" })
               draw_bg +: {color: (if processing { #x9ca3af } else { #x2563eb })
                           color_hover: #x1d4ed8 color_down: #x1e40af}
               draw_text +: {color: #xffffff}
               on_click: || approve_plan()}
    ButtonFlat{text: "撤销最近一次"
               draw_bg +: {color: #xfbbf24 color_hover: #xf59e0b color_down: #xd97706}
               draw_text +: {color: #x1c1c1e}
               on_click: || undo_last_change()}
    ButtonFlat{text: (if trace_open { "隐藏轨迹" } else { "展开轨迹" })
               draw_bg +: {color: #xe5e7eb color_hover: #xd1d5db color_down: #x9ca3af}
               draw_text +: {color: #x1c1c1e}
               on_click: || toggle_trace()}
    }

    status_row := RoundedView{width: Fill height: Fit flow: Down padding: 8
                              draw_bg.color: #xffffff
                              on_render: || {
        Label{text: "状态：" + status_text draw_text.color: #x1c1c1e}
        if pending_block_complete.id != nil {
            Label{text: "提示：块已标记完成，请前往任务列表更新剩余工时"
                  draw_text.color: #xb45309}
        }
        if last_error != "" {
            Label{text: "最近错误：" + last_error draw_text.color: #xb91c1c}
        }
    }}

    plan_panel := RoundedView{width: Fill height: Fit flow: Down padding: 8
                              draw_bg.color: #xffffff
                              on_render: || {
        if plan_payload.planId == nil {
            Label{text: "尚无方案" draw_text.color: #x8e8e93}
            return
        }
        Label{text: "方案 " + plan_payload.planId + "（baseVersion " +
                   plan_payload.baseVersion.to_string() + "）"
              draw_text.color: #x1c1c1e}
        for i in plan_payload.changes.len() {
            let ch = plan_payload.changes[i]
            let before_s = if ch.before == nil { "空" } else { ch.before.start + "–" + ch.before.end }
            let after_s = if ch.after == nil { "空" } else { ch.after.start + "–" + ch.after.end }
            Label{text: ch.blockId + ": " + before_s + " → " + after_s
                  draw_text.color: #x1c1c1e}
        }
    }}

    replan_row := RoundedView{width: Fill height: Fit flow: Down padding: 8
                              draw_bg.color: #xffffff
                              on_render: || {
        if last_failure_reason == "" { return }
        Label{text: "最近失败：" + last_failure_reason draw_text.color: #xb91c1c}
        Label{text: "可调整后重规划，或查看切分/取舍建议"
              draw_text.color: #x1c1c1e}
        ButtonFlat{text: "调整后重规划"
                   draw_bg +: {color: #xf59e0b color_hover: #xd97706 color_down: #xb45309}
                   draw_text +: {color: #xffffff}
                   on_click: || replan_after_failure()}
    }}

    propose_panel := RoundedView{width: Fill height: (if propose_panel_open { Fit } else { 0 })
                                 flow: Down padding: 8
                                 draw_bg.color: #xffffff
                                 on_render: || {
        if not propose_panel_open { return }
        Label{text: "模型提议的任务（请审阅并修改后接受）" draw_text.color: #x1c1c1e}
        for i in proposed_tasks.len() {
            let p = proposed_tasks[i]
            Label{text: p.id + " · " + (p.title or "")
                  + " · " + p.remainingHours.to_string() + "h"
                  draw_text.color: #x1c1c1e}
        }
        actions := RoundedView{width: Fill height: Fit flow: Right padding: 4
                               draw_bg.color: #xffffff
            ButtonFlat{text: "接受入项目"
                       draw_bg +: {color: #x16a34a color_hover: #x15803d color_down: #x166534}
                       draw_text +: {color: #xffffff}
                       on_click: || accept_proposed_tasks()}
            ButtonFlat{text: "拒绝"
                       draw_bg +: {color: #x6b7280 color_hover: #x4b5563 color_down: #x374151}
                       draw_text +: {color: #xffffff}
                       on_click: || reject_proposed_tasks()}
        }
    }}

    trace_panel := RoundedView{width: Fill height: (if trace_open { Fill } else { 0 })
                               flow: Down padding: 8
                               draw_bg.color: #xf3f4f6
                               on_render: render_trace_inner}
}
