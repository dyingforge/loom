fn clone_value(value) { return value.to_json().parse_json() }
fn has_field(value, name) { for key item in value { if "" + key == name { return true } }; return false }
fn padded(value) { return (if value < 10 { "0" } else { "" }) + value }
fn calendar_iso(epoch) {
    let parts = local_time(epoch)
    return "" + parts.year + "-" + padded(parts.month) + "-" + padded(parts.day) + "T" + padded(parts.hour) + ":" + padded(parts.minute) + ":00"
}
fn date_text(epoch) { return calendar_iso(epoch).split("T")[0] }
fn clock_text(epoch) { let parts = local_time(epoch); return padded(parts.hour) + ":" + padded(parts.minute) }
fn now_epoch() { return time_now() + beijing_offset_hours * 3600 }
fn current_iso() { return calendar_iso(now_epoch()) }
fn today_epoch() { return floor(now_epoch() / 86400) * 86400 }
fn month_start(epoch) { return floor(epoch / 86400) * 86400 - (local_time(epoch).day - 1) * 86400 }
fn next_month(epoch) { return month_start(month_start(epoch) + 32 * 86400) }
fn previous_month(epoch) { return month_start(month_start(epoch) - 86400) }
fn deadline_epoch(text) {
    let today = today_epoch()
    for index in 367 { let day = today + index * 86400; if date_text(day) == text { return day + 18 * 3600 } }
    return nil
}
fn task_by_id(value, identifier) { for task in value.tasks { if task.id == identifier { return task } }; return nil }
fn block_by_id(value, identifier) {
    for task in value.tasks { for block in task.blocks { if block.id == identifier { return block } } }; return nil
}
fn same_block(left, right) {
    if left == nil or right == nil { return left == nil and right == nil }
    return left.id == right.id and left.taskId == right.taskId and left.start == right.start and left.end == right.end and left.done == right.done
}
fn plan_project(base, approved) {
    assert(base.version == approved.baseVersion)
    let result = clone_value(base)
    let seen = {}
    for change in approved.changes {
        assert(!has_field(seen, change.blockId)); seen[change.blockId] = true
        assert(same_block(block_by_id(base, change.blockId), change.before))
        for task in result.tasks {
            let kept = []; for block in task.blocks { if block.id != change.blockId { kept.push(block) } }; task.blocks = kept
        }
        if change.after != nil {
            assert(change.after.id == change.blockId)
            let owner = task_by_id(result, change.after.taskId); assert(owner != nil)
            owner.blocks.push(clone_value(change.after))
        }
    }
    result.version = base.version + 1
    return result
}
fn add_code(codes, seen, code) {
    if !has_field(seen, code) { seen[code] = true; codes.push(code) }
}
fn days_from_civil(yy, mm, dd) {
    let y = if mm <= 2 { yy - 1 } else { yy }
    let num = if y >= 0 { y } else { y - 399 }
    let era = floor(num / 400)
    let yoe = y - era * 400
    let mp = if mm > 2 { mm - 3 } else { mm + 9 }
    let doy = floor((153 * mp + 2) / 5) + dd - 1
    let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
    return era * 146097 + doe - 719468
}
fn iso_epoch(text) {
    if text == nil { return 0 }
    let parts = text.split("T")
    if parts.len() < 2 { return 0 }
    let d = parts[0].split("-")
    let t = parts[1].split(":")
    if d.len() < 3 or t.len() < 2 { return 0 }
    let year = floor(d[0].to_f64())
    let month = floor(d[1].to_f64())
    let day = floor(d[2].to_f64())
    let hour = floor(t[0].to_f64())
    let minute = floor(t[1].to_f64())
    let second = if t.len() >= 3 { floor(t[2].to_f64()) } else { 0 }
    return days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
}
fn iso_weekday_py(text) { return (local_time(iso_epoch(text)).weekday + 6) % 7 }
fn is_rest_day(rest_days, weekday) { for day in rest_days { if day == weekday { return true } }; return false }
fn block_hours(block) { return (iso_epoch(block.end) - iso_epoch(block.start)) / 3600.0 }
fn clock_minutes(text) {
    let parts = text.split(":")
    if parts.len() < 2 { return 0 }
    return floor(parts[0].to_f64()) * 60 + floor(parts[1].to_f64())
}
fn iso_lt(a, b) { return iso_epoch(a) < iso_epoch(b) }
fn sort_blocks(blocks) {
    let result = []
    for block in blocks { result.push(block) }
    for index in result.len() {
        let position = index
        while position > 0 and (iso_epoch(result[position].start) < iso_epoch(result[position - 1].start) or (iso_epoch(result[position].start) == iso_epoch(result[position - 1].start) and iso_epoch(result[position].end) < iso_epoch(result[position - 1].end))) {
            let prior = result[position - 1]
            result[position - 1] = result[position]; result[position] = prior
            position = position - 1
        }
    }
    return result
}
fn has_dep_cycle(tasks) {
    let ids = {}
    for task in tasks { ids[task.id] = true }
    let indegree = {}
    for task in tasks { indegree[task.id] = 0 }
    for task in tasks { for dep in task.dependsOn { if has_field(ids, dep) { indegree[task.id] = indegree[task.id] + 1 } } }
    let removed = {}; let count = 0; let changed = true
    while changed {
        changed = false
        for task in tasks {
            if has_field(removed, task.id) { continue }
            if indegree[task.id] == 0 {
                removed[task.id] = true; count = count + 1; changed = true
                for other in tasks {
                    if has_field(removed, other.id) { continue }
                    for dep in other.dependsOn { if dep == task.id { indegree[other.id] = indegree[other.id] - 1 } }
                }
            }
        }
    }
    return count < tasks.len()
}
fn structure_bad(project) {
    let ids = {}
    for task in project.tasks { ids[task.id] = true }
    for task in project.tasks { for dep in task.dependsOn { if !has_field(ids, dep) { return true } } }
    for task in project.tasks { if task.done and task.remainingHours != 0 { return true } }
    return has_dep_cycle(project.tasks)
}
fn validate_codes(project, candidate, now) {
    let codes = []; let seen = {}
    let tasks_map = {}; let dup_task = false
    for task in project.tasks { if has_field(tasks_map, task.id) { dup_task = true }; tasks_map[task.id] = task }
    if dup_task { add_code(codes, seen, "C0") }
    let existing = {}; let dup_block = false
    for task in project.tasks { for block in task.blocks { if has_field(existing, block.id) { dup_block = true }; existing[block.id] = block } }
    if dup_block { add_code(codes, seen, "C0") }
    if structure_bad(project) { add_code(codes, seen, "C4") }
    let work_start = project.workHours.start
    let work_end = project.workHours.end
    let rest_days = project.restDays
    let hours_map = {}; let future = []; let ids_seen = {}
    for block in candidate.blocks {
        let identifier = if block.id != nil { block.id } else { block.taskId }
        if block.id != nil {
            if has_field(ids_seen, block.id) { add_code(codes, seen, "C0") }
            ids_seen[block.id] = true
        }
        let task = if has_field(tasks_map, block.taskId) { tasks_map[block.taskId] } else { nil }
        if task == nil { add_code(codes, seen, "C0"); continue }
        let old = if block.id != nil and has_field(existing, block.id) { existing[block.id] } else { nil }
        let locked = old != nil and (old.done or (now != nil and iso_lt(old.start, now)))
        if locked {
            if !(block.taskId == old.taskId and block.start == old.start and block.end == old.end and block.done == old.done) {
                add_code(codes, seen, "C1")
            }
            continue
        }
        if block.done or task.done or (now != nil and iso_lt(block.start, now)) { add_code(codes, seen, "C1") }
        if old != nil and old.taskId != block.taskId { add_code(codes, seen, "C0") }
        if block.start.split("T")[0] != block.end.split("T")[0] or clock_minutes(block.start.split("T")[1]) < clock_minutes(work_start) or clock_minutes(block.end.split("T")[1]) > clock_minutes(work_end) or is_rest_day(rest_days, iso_weekday_py(block.start)) {
            add_code(codes, seen, "C3")
        }
        for event in project.fixedEvents {
            let bs = iso_epoch(block.start); let be = iso_epoch(block.end)
            let es = iso_epoch(event.start); let ee = iso_epoch(event.end)
            let overlap_start = if bs > es { bs } else { es }
            let overlap_end = if be < ee { be } else { ee }
            if overlap_start < overlap_end { add_code(codes, seen, "C2") }
        }
        if !has_field(hours_map, block.taskId) { hours_map[block.taskId] = 0 }
        hours_map[block.taskId] = hours_map[block.taskId] + block_hours(block)
        future.push(block)
    }
    for identifier old in existing {
        if (old.done or (now != nil and iso_lt(old.start, now))) and !has_field(ids_seen, identifier) {
            add_code(codes, seen, "C1")
        }
    }
    let ordered = sort_blocks(candidate.blocks)
    for index in ordered.len() {
        let block = ordered[index]
        for prev_index in index {
            let previous = ordered[prev_index]
            if iso_lt(block.start, previous.end) { add_code(codes, seen, "C6") }
        }
    }
    for task in project.tasks {
        let expected = if task.done { 0 } else { task.remainingHours }
        let actual = if has_field(hours_map, task.id) { hours_map[task.id] } else { 0 }
        if abs(actual - expected) > 0.000001 { add_code(codes, seen, "C5") }
        let blocks = []
        for block in future { if block.taskId == task.id { blocks.push(block) } }
        for dependency in task.dependsOn {
            let predecessor = if has_field(tasks_map, dependency) { tasks_map[dependency] } else { nil }
            if predecessor == nil or predecessor.done or predecessor.remainingHours == 0 or blocks.len() == 0 { continue }
            let before = []
            for block in future { if block.taskId == dependency { before.push(block.end) } }
            if before.len() == 0 { continue }
            let min_start = iso_epoch(blocks[0].start)
            for block in blocks { if iso_epoch(block.start) < min_start { min_start = iso_epoch(block.start) } }
            let max_end = iso_epoch(before[0])
            for end in before { if iso_epoch(end) > max_end { max_end = iso_epoch(end) } }
            if min_start < max_end { add_code(codes, seen, "C4") }
        }
    }
    return codes
}
fn adjustable_codes(changes, project) {
    let codes = []; let seen = {}
    let tasks_map = {}
    for task in project.tasks { tasks_map[task.id] = task }
    for change in changes {
        let owners = {}
        if change.before != nil { owners[change.before.taskId] = true }
        if change.after != nil { owners[change.after.taskId] = true }
        for identifier owner_flag in owners {
            if !has_field(tasks_map, identifier) or !tasks_map[identifier].adjustable {
                add_code(codes, seen, "C7")
            }
        }
    }
    return codes
}
fn day_free_hours(project, seg_start, seg_end, now_iso) {
    let locked = []
    for event in project.fixedEvents {
        let ls = iso_epoch(event.start); let le = iso_epoch(event.end)
        let cs = if ls > seg_start { ls } else { seg_start }
        let ce = if le < seg_end { le } else { seg_end }
        if ce > cs { locked.push({start: cs, end: ce}) }
    }
    for task in project.tasks { for block in task.blocks {
        if block.done or (now_iso != nil and iso_lt(block.start, now_iso)) {
            let ls = iso_epoch(block.start); let le = iso_epoch(block.end)
            let cs = if ls > seg_start { ls } else { seg_start }
            let ce = if le < seg_end { le } else { seg_end }
            if ce > cs { locked.push({start: cs, end: ce}) }
        }
    }}
    let ordered = []
    for interval in locked { ordered.push(interval) }
    for index in ordered.len() {
        let position = index
        while position > 0 and ordered[position].start < ordered[position - 1].start {
            let prior = ordered[position - 1]; ordered[position - 1] = ordered[position]; ordered[position] = prior
            position = position - 1
        }
    }
    let free = 0; let cur = seg_start
    for interval in ordered {
        if interval.start > cur { free = free + interval.start - cur }
        if interval.end > cur { cur = interval.end }
    }
    if seg_end > cur { free = free + seg_end - cur }
    return free
}
fn available_hours(project, now_iso, end_iso) {
    let ws = clock_minutes(project.workHours.start) * 60
    let we = clock_minutes(project.workHours.end) * 60
    let start = iso_epoch(now_iso)
    let end = iso_epoch(end_iso)
    if end <= start { return 0 }
    let total = 0
    let day = floor(start / 86400) * 86400
    let last = floor(end / 86400) * 86400
    while day <= last {
        let py_weekday = (local_time(day).weekday + 6) % 7
        if !is_rest_day(project.restDays, py_weekday) {
            let seg_start = if day + ws > start { day + ws } else { start }
            let seg_end = if day + we < end { day + we } else { end }
            if seg_end > seg_start { total = total + day_free_hours(project, seg_start, seg_end, now_iso) }
        }
        day = day + 86400
    }
    return total / 3600.0
}
fn capacity_compute(project, now_iso) {
    let required = 0
    for task in project.tasks { if !task.done { required = required + task.remainingHours } }
    let available = nil
    if project.deadline != nil and project.deadline != "" {
        available = available_hours(project, now_iso, project.deadline)
    }
    return {remainingHours: required, availableHours: available,
        gapHours: if available == nil { nil } else { max(0, required - available) }}
}
fn verify_calendar_reasons(before, draft, plan, readback, now_iso) {
    let reasons = []
    if before.id != draft.id or before.version != draft.version or plan.baseVersion != before.version {
        reasons.push("候选计划与当前日历的编号或版本不一致")
    }
    if readback.version != before.version + 1 { reasons.push("保存后的日历版本必须增加一次") }
    if before.fixedEvents.to_json() != draft.fixedEvents.to_json()
        or before.workHours.to_json() != draft.workHours.to_json()
        or before.restDays.to_json() != draft.restDays.to_json() {
        reasons.push("候选计划修改了已经保存的工作时间或固定日程")
    }
    let new_tasks = {}
    for task in readback.tasks { new_tasks[task.id] = task }
    let new_blocks = {}
    for task in readback.tasks { for block in task.blocks { new_blocks[block.id] = block } }
    for task in before.tasks {
        let replacement = if has_field(new_tasks, task.id) { new_tasks[task.id] } else { nil }
        if task.done and (replacement == nil or !replacement.done or replacement.remainingHours != task.remainingHours) {
            reasons.push("已经完成的任务记录发生变化：" + task.id)
        }
        for block in task.blocks {
            if block.done or iso_lt(block.start, now_iso) {
                let nb = if has_field(new_blocks, block.id) { new_blocks[block.id] } else { nil }
                if nb == nil or !same_block(block, nb) { reasons.push("已经开始或完成的日历安排发生变化：" + block.id) }
            }
        }
    }
    if reasons.len() == 0 {
        let applied = plan_project(draft, plan)
        if applied.to_json() != readback.to_json() { reasons.push("完整回读任务与获准候选计划不一致") }
    }
    let candidate = {blocks: []}
    for task in readback.tasks { for block in task.blocks { candidate.blocks.push(block) } }
    let codes = validate_codes(draft, candidate, now_iso)
    if codes.len() > 0 { reasons.push("约束核验未通过：" + codes.to_json()) }
    return reasons
}
let schema_tasks = {type: "object" required: ["tasks"] additionalProperties: false
    properties: {tasks: {type: "array" maxItems: 64 items: {type: "object" required: ["id" "title" "priority" "remainingHours" "dependsOn" "adjustable"]
        additionalProperties: false properties: {
            id: {type: "string" minLength: 1 maxLength: 80}
            title: {type: "string" minLength: 1 maxLength: 200}
            priority: {type: "integer" minimum: 1 maximum: 5}
            remainingHours: {type: "number" minimum: 0 maximum: 720}
            dependsOn: {type: "array" maxItems: 32 items: {type: "string"}}
            adjustable: {type: "boolean"}
        }}}}}
let schema_blocks = {type: "object" required: ["blocks"] additionalProperties: false
    properties: {blocks: {type: "array" maxItems: 512 items: {type: "object" required: ["taskId" "start" "end"]
        additionalProperties: false properties: {
            taskId: {type: "string" minLength: 1 maxLength: 80}
            start: {type: "string" minLength: 16 maxLength: 19}
            end: {type: "string" minLength: 16 maxLength: 19}
            done: {type: "boolean"}
        }}}}}
fn model_complete(task, input, schema, done) {
    host.request("model.complete", {task: task input: input schema: schema class: "strong"}, done)
}
fn on_model_error(error) {
    let message = if error == nil { "未知错误" } else { "" + error }
    if message.search("no service answers") >= 0 {
        demo_mode = true
        app_state.demoMode = true
        update_mode_badge()
        start_demo_planning(app_state.lastRequest)
        return
    }
    planning_failed("模型调用失败：" + message)
}
fn next_workday(rest_days) {
    let day = today_epoch() + 86400
    for index in 21 {
        let candidate = day + index * 86400
        let weekday = (local_time(candidate).weekday + 6) % 7
        if !is_rest_day(rest_days, weekday) { return candidate }
    }
    return day
}
fn at_clock(day, text) { return date_text(day) + "T" + text + ":00" }
fn demo_tasks() {
    return [
        {id: "demo-1", title: "检查新增记录", priority: 2, remainingHours: 0.5, dependsOn: [], adjustable: false, done: false},
        {id: "demo-2", title: "检查列表", priority: 2, remainingHours: 0.5, dependsOn: [], adjustable: false, done: false},
        {id: "demo-3", title: "检查本地保存", priority: 2, remainingHours: 0.5, dependsOn: [], adjustable: false, done: false},
        {id: "demo-4", title: "编写讲解说明", priority: 1, remainingHours: 1, dependsOn: ["demo-1", "demo-2", "demo-3"], adjustable: false, done: false}
    ]
}
