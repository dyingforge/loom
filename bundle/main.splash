let Text = Label{padding: 0 draw_text +: {color: ink text_style: chinese}}
let Small = Text{draw_text +: {color: muted text_style.font_size: 9}}
let Heading = Text{draw_text.text_style: chinese_bold}
let Card = RoundedView{width: Fill height: Fit flow: Down padding: 24 spacing: 16
    draw_bg +: {color: #xffffff border_color: line border_size: 1 border_radius: 16}}
let Action = ButtonFlat{height: 40 padding: Inset{left: 16 right: 16}
    draw_bg +: {color: brand color_hover: #x287665 color_down: #x174f44 color_disabled: #xdfe7e2 border_radius: 8}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_disabled: faint text_style: chinese_medium}}
let Subtle = Action{draw_bg +: {color: #xffffff color_hover: brand_soft color_down: #xdfe7e2 border_color: line border_size: 1}
    draw_text +: {color: ink color_hover: brand color_down: brand}}
let Input = TextInput{height: 40 width: Fill padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {color: #xffffff color_hover: #xf5f7f6 color_focus: #xe8f2ed color_empty: #xffffff border_color: line border_size: 1 border_radius: 8}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: faint color_empty_hover: faint text_style: chinese}}
fn default_project() { return {id: "loom-calendar", version: 0, goal: "", deadline: nil, milestones: [], tasks: [], fixedEvents: [],
    workHours: {start: "09:00", end: "18:00"}, restDays: [5, 6], preferences: "", autoAdjust: false} }
fn default_state() { return {schema: 3, project: default_project(), draftProject: nil, plan: nil, receipt: nil,
    pendingVerification: nil, calendar: {}, capacity: nil, formalCapacity: nil, activeJob: nil,
    lastRequest: nil, phase: "idle", error: "", savedAt: "", confirmedRationale: "", confirmedRisks: [],
    questionId: "initial", question: "", resumeToken: "", workingProject: nil,
    utcOffset: 0, timezone: "", month: 0, selectedDay: 0, showingFormal: false} }
let project = default_project()
let app_state = default_state()
let displayed = project
let busy = false
let editing_goal = true
let loaded = false
let progress_text = ""
let status_text = "填写目标与截止日期，自动生成每日安排"
let api_origin = "https://quotes-geographical-per-foreign.trycloudflare.com"
let business_version = 0
let saved_sequence = 0
let saved_file = ""
let storage_error = ""
let draft_question = "initial"
let draft_revision = 0
let draft_goal = ""
let draft_deadline = ""
let draft_answer = ""

fn clone_value(value) { return value.to_json().parse_json() }
fn has_field(value, name) { for key item in value { if "" + key == name { return true } }; return false }
fn padded(value) { return (if value < 10 { "0" } else { "" }) + value }
fn calendar_iso(epoch) {
    let parts = local_time(epoch)
    return "" + parts.year + "-" + padded(parts.month) + "-" + padded(parts.day) + "T" + padded(parts.hour) + ":" + padded(parts.minute) + ":00"
}
fn date_text(epoch) { return calendar_iso(epoch).split("T")[0] }
fn clock_text(epoch) { let parts = local_time(epoch); return padded(parts.hour) + ":" + padded(parts.minute) }
fn now_epoch() { return time_now() + app_state.utcOffset * 3600 }
fn current_iso() { return calendar_iso(now_epoch()) }
fn today_epoch() { return floor(now_epoch() / 86400) * 86400 }
fn month_start(epoch) { return floor(epoch / 86400) * 86400 - (local_time(epoch).day - 1) * 86400 }
fn next_month(epoch) { return month_start(month_start(epoch) + 32 * 86400) }
fn previous_month(epoch) { return month_start(month_start(epoch) - 86400) }
fn deadline_epoch(text) {
    let today = today_epoch()
    for index in 367 { let day = today + index * 86400; if date_text(day) == text { return day + 18 * 3600 } }
    return nil
}
fn task_by_id(value, identifier) { for task in value.tasks { if task.id == identifier { return task } }; return nil }
fn block_by_id(value, identifier) {
    for task in value.tasks { for block in task.blocks { if block.id == identifier { return block } } }; return nil
}
fn same_block(left, right) {
    if left == nil or right == nil { return left == nil and right == nil }
    return left.id == right.id and left.taskId == right.taskId and left.start == right.start and left.end == right.end and left.done == right.done
}
fn plan_project(base, approved) {
    assert(base.version == approved.baseVersion)
    let result = clone_value(base)
    let seen = {}
    for change in approved.changes {
        assert(!has_field(seen, change.blockId)); seen[change.blockId] = true
        assert(same_block(block_by_id(base, change.blockId), change.before))
        for task in result.tasks {
            let kept = []; for block in task.blocks { if block.id != change.blockId { kept.push(block) } }; task.blocks = kept
        }
        if change.after != nil {
            assert(change.after.id == change.blockId)
            let owner = task_by_id(result, change.after.taskId); assert(owner != nil)
            owner.blocks.push(clone_value(change.after))
        }
    }
    result.version = base.version + 1
    return result
}
let record_fields = ["schema", "sequence", "businessVersion", "business", "draft"]
let business_fields = ["schema", "project", "draftProject", "plan", "receipt", "pendingVerification",
    "calendar", "capacity", "formalCapacity", "activeJob", "lastRequest", "phase", "error", "savedAt",
    "confirmedRationale", "confirmedRisks", "questionId", "question", "resumeToken", "workingProject",
    "utcOffset", "timezone", "month", "selectedDay", "showingFormal"]
let draft_fields = ["projectId", "questionId", "revision", "goal", "deadline", "answer"]
fn complete_record(record) {
    if record == nil or !record.is_object() { return false }
    for field in record_fields { if !has_field(record, field) { return false } }
    if record.schema != 1 or record.sequence < 1 or record.businessVersion < 0 { return false }
    let business = record.business
    if business == nil or !business.is_object() { return false }
    for field in business_fields { if !has_field(business, field) { return false } }
    let saved_project = business.project
    if saved_project == nil or !saved_project.is_object() or !has_field(saved_project, "id") { return false }
    let draft = record.draft
    if draft == nil or !draft.is_object() { return false }
    for field in draft_fields { if !has_field(draft, field) { return false } }
    if draft.projectId != saved_project.id or draft.questionId == "" { return false }
    return true
}
fn parse_record(text) {
    if text == nil or text == "" { return nil }
    let value = text.parse_json()
    if value == nil or !complete_record(value) { return nil }
    return value
}
fn read_record(path) {
    if !fs.exists(path) { return nil }
    return parse_record(fs.read(path))
}
fn persist(business, draft, bump) {
    let next_sequence = saved_sequence + 1
    let next_version = business_version
    if bump { next_version = next_version + 1 }
    let record = {schema: 1, sequence: next_sequence, businessVersion: next_version, business: business, draft: draft}
    let text = record.to_json()
    if text == nil or text == "" { storage_error = "本地记录序列化失败"; return false }
    # 每次写到另一份文件，回读比较后再更新序号和业务版本；失败就停止本次操作。
    let target = if saved_file == "state-a.json" { "state-b.json" } else { "state-a.json" }
    fs.write(target, text)
    let read_back = fs.read(target)
    if read_back != text { storage_error = "本地记录写入后回读不一致"; return false }
    let parsed = parse_record(read_back)
    if parsed == nil { storage_error = "本地记录回读内容不完整"; return false }
    if parsed.sequence != next_sequence or parsed.businessVersion != next_version {
        storage_error = "本地记录回读字段不一致"; return false
    }
    saved_sequence = next_sequence; saved_file = target; business_version = next_version
    return true
}
fn current_draft() {
    return {projectId: project.id, questionId: draft_question, revision: draft_revision,
        goal: draft_goal, deadline: draft_deadline, answer: draft_answer}
}
fn save_business() {
    if !persist(app_state, current_draft(), true) { show_status("本地记录保存失败：" + storage_error); return false }
    return true
}
fn save_draft() {
    if !loaded { return }
    # 修订号在客户端内单调递增，不因切换问题重置。
    draft_revision = draft_revision + 1
    if !persist(app_state, current_draft(), false) { show_status("本地记录保存失败：" + storage_error) }
}
fn show_status(text) { status_text = text; ui.status_label.set_text(text); ui.status_label.set_visible(true) }
fn refresh_actions() { ui.generate_action.render(); ui.revision_action.render() }
fn refresh() {
    displayed = if app_state.plan != nil and !app_state.showingFormal { plan_project(app_state.draftProject, app_state.plan) } else { project }
    ui.goal_form.set_visible(editing_goal)
    ui.goal_summary.set_visible(!editing_goal)
    ui.goal_summary.render(); ui.page_heading.render()
    ui.view_banner.set_visible(app_state.plan != nil and project.tasks.len() > 0); ui.view_banner.render()
    ui.month_header.render(); ui.calendar_grid.render(); ui.calendar_legend.render()
    ui.day_detail.render(); ui.plan_summary.render(); ui.risk_panel.render()
    ui.modification.set_visible(!editing_goal and (app_state.plan != nil or project.tasks.len() > 0 or app_state.phase == "clarify"))
    refresh_actions()
}
fn input_changed() {
    if !loaded { return }
    draft_goal = ui.goal_input.text(); draft_deadline = ui.deadline_input.text()
    save_draft(); ui.generate_action.render()
}
fn advice_changed(text) {
    if !loaded { return }; draft_answer = text; save_draft(); ui.revision_action.render()
}
fn select_day(epoch) { app_state.selectedDay = epoch; ui.calendar_grid.render(); ui.day_detail.render() }
fn change_month(direction) {
    app_state.month = if direction < 0 { previous_month(app_state.month) } else { next_month(app_state.month) }
    app_state.selectedDay = app_state.month
    ui.month_header.render(); ui.calendar_grid.render(); ui.day_detail.render()
}
fn select_today() {
    app_state.month = month_start(today_epoch()); app_state.selectedDay = today_epoch()
    ui.month_header.render(); ui.calendar_grid.render(); ui.day_detail.render()
}
fn day_items(epoch) {
    let rows = []; let day = date_text(epoch)
    for task in displayed.tasks {
        for block in task.blocks {
            if block.start.split("T")[0] == day {
                assert(has_field(app_state.calendar, block.start) and has_field(app_state.calendar, block.end))
                rows.push({title: task.title, start: app_state.calendar[block.start], end: app_state.calendar[block.end],
                    taskId: task.id, fixed: block.done or app_state.calendar[block.start] < now_epoch(), done: block.done, blockId: block.id})
            }
        }
    }
    for event in displayed.fixedEvents {
        if event.start.split("T")[0] == day {
            rows.push({title: event.title, start: app_state.calendar[event.start], end: app_state.calendar[event.end], taskId: nil, fixed: true, done: false, blockId: event.id})
        }
    }
    for index in rows.len() {
        let position = index
        while position > 0 and rows[position].start < rows[position - 1].start {
            let prior = rows[position - 1]; rows[position - 1] = rows[position]; rows[position] = prior; position = position - 1
        }
    }
    return rows
}
fn total_hours(value) { let hours = 0; for task in value.tasks { if !task.done { hours = hours + task.remainingHours } }; return hours }
fn short_deadline(value) {
    if value.deadline == nil { return "" }
    let parts = local_time(app_state.calendar[value.deadline])
    return padded(parts.month) + "/" + padded(parts.day)
}
fn latest_end(value) {
    let end = 0; for task in value.tasks { for block in task.blocks { end = max(end, app_state.calendar[block.end]) } }; return end
}
fn capacity_info() {
    let value = if app_state.showingFormal { app_state.formalCapacity } else { app_state.capacity }
    if value == nil {
        return {title: "你的工作日", text: "周一至周五 09:00–18:00，周末休息。生成计划时会检查工时与依赖。", risks: [], warning: false}
    }
    let risks = []
    if value.gapHours > 0 { risks.push("缺少 " + value.gapHours + " 小时，请编辑截止日期或提出修改建议。") }
    if app_state.plan != nil and !app_state.showingFormal { for entry in app_state.plan.risks { risks.push(entry) } }
    elif has_field(app_state, "confirmedRisks") { for entry in app_state.confirmedRisks { risks.push(entry) } }
    return {title: if risks.len() > 0 { "截止日期需要关注" } else { "工作时间与期限" },
        text: "剩余工作 " + value.remainingHours + " 小时，期限内可用 " + (round(value.availableHours * 10) / 10) + " 小时。",
        risks: risks, warning: risks.len() > 0}
}
fn request_api(path, body) {
    let pending = promise(); let finished = false
    let timer = start_timeout(660, || {
        if !finished { finished = true; pending.resolve({failed: "服务请求超过等待时间", response: nil}) }
    })
    net.http_request(net.HttpRequest{
        url: api_origin + path method: if body == nil { net.HttpMethod.GET } else { net.HttpMethod.POST }
        headers: {"Content-Type": "application/json"} body: if body == nil { nil } else { body.to_json().to_bytes() }
    }) do net.HttpEvents{
        on_response: |response| {
            println("Loom HTTP " + path + " " + response.status_code)
            if !finished { finished = true; stop_timer(timer); pending.resolve({failed: "", response: response}) }
        }
        on_error: |error| { if !finished { finished = true; stop_timer(timer); pending.resolve({failed: error.message, response: nil}) } }
    }
    return pending
}
fn detail_text(detail) {
    if detail.is_object() and has_field(detail, "message") { return "" + detail.message }
    return "" + detail
}
fn request_error(outcome) {
    if outcome.failed != "" { return outcome.failed }
    if outcome.response.status_code >= 400 {
        let raw = outcome.response.body.to_string().trim()
        let message = "服务请求失败（HTTP " + outcome.response.status_code + "）"
        if raw.search("{") == 0 {
            let body = raw.parse_json()
            if has_field(body, "detail") { message = message + "：" + detail_text(body.detail) }
            elif has_field(body, "error") { message = message + "：" + detail_text(body.error) }
        }
        return message
    }
    return ""
}
fn planning_failed(reason) {
    busy = false; app_state.activeJob = nil; app_state.phase = "failed"; app_state.error = reason
    if save_business() { show_status("本次规划已停止：" + reason) }
    refresh()
}
fn poll_planning() {
    let started = time_now()
    loop {
        let outcome = request_api("/v1/agent/jobs/" + app_state.activeJob, nil).await()
        let error = request_error(outcome)
        if error != "" { planning_failed(error); return }
        let response = outcome.response.body.to_string().parse_json()
        if response.status == "complete" {
            app_state.activeJob = nil
            let result = response.result
            app_state.capacity = result.capacity
            let message = ""
            if result.type == "plan" {
                app_state.plan = result.payload; app_state.draftProject = result.draftProject
                for key value in result.calendar { app_state.calendar["" + key] = value }
                app_state.phase = "candidate"; app_state.showingFormal = false; app_state.pendingVerification = nil
                app_state.error = ""; draft_answer = ""; ui.advice_input.set_text("")
                app_state.question = ""; app_state.resumeToken = ""; app_state.questionId = "initial"
                draft_question = "initial"
                message = "候选计划已生成，请查看日历并确认"
            } elif result.type == "clarify" {
                app_state.phase = "clarify"
                app_state.question = result.payload.question
                app_state.resumeToken = result.resumeToken
                app_state.questionId = result.resumeToken
                app_state.workingProject = result.draftProject
                draft_question = result.resumeToken; draft_answer = ""
                ui.advice_input.set_text("")
                message = result.payload.question
            } else { planning_failed(result.payload.reason); return }
            editing_goal = false
            let saved = save_business()
            busy = false
            if saved { show_status(message) }
            refresh(); return
        }
        assert(response.status == "running")
        progress_text = response.stage; show_status(progress_text); ui.plan_summary.render()
        if time_now() - started > 650 { planning_failed("规划超过等待时间"); return }
    }
}
fn launch_request(request) {
    busy = true; app_state.lastRequest = clone_value(request)
    app_state.phase = if request.trigger == "compose" { "generating" } else { "revising" }
    app_state.error = ""; progress_text = if request.trigger == "compose" { "正在拆分目标" } else { "正在根据建议调整任务和时间" }
    editing_goal = false
    if !save_business() { busy = false; refresh(); return }
    show_status(progress_text); refresh()
    let outcome = request_api("/v1/agent/jobs", request).await()
    let error = request_error(outcome); if error != "" { planning_failed(error); return }
    let response = outcome.response.body.to_string().parse_json()
    app_state.activeJob = response.jobId
    if !save_business() { busy = false; refresh(); return }
    poll_planning()
}
fn generate_plan() {
    if busy { return }
    let goal = ui.goal_input.text().trim(); let due = deadline_epoch(ui.deadline_input.text().trim())
    if goal == "" { show_status("请填写你的目标"); return }
    if due == nil or due <= now_epoch() { show_status("请填写未来一年内有效的截止日期，格式为 YYYY-MM-DD"); return }
    let snapshot = clone_value(project); snapshot.goal = goal; snapshot.deadline = calendar_iso(due)
    app_state.calendar[snapshot.deadline] = due
    launch_request({snapshot: snapshot, trigger: "compose", instruction: "", now: current_iso()})
}
fn revise_plan() {
    if busy { return }
    let advice = ui.advice_input.text().trim(); if advice == "" { return }
    if app_state.phase == "clarify" {
        let answer = ui.advice_input.text().trim()
        if answer == "" { show_status("请填写你的回答"); return }
        draft_answer = answer
        # 同步保存最新输入后再提交回答。
        save_draft()
        launch_request({snapshot: app_state.workingProject, trigger: "resume", instruction: "",
            resumeToken: app_state.resumeToken, clarificationAnswer: answer, now: current_iso()}); return
    }
    let snapshot = if app_state.plan != nil { plan_project(app_state.draftProject, app_state.plan) } else { clone_value(project) }
    snapshot.version = project.version
    snapshot.preferences = snapshot.preferences + "\n用户修改建议：" + advice
    launch_request({snapshot: snapshot, trigger: "revise", instruction: advice, now: current_iso()})
}
fn retry_planning() {
    if busy or app_state.lastRequest == nil { return }
    let request = clone_value(app_state.lastRequest); request.now = current_iso(); launch_request(request)
}
fn edit_goal() {
    if busy { return }
    let value = if app_state.draftProject != nil { app_state.draftProject } else { project }
    ui.goal_input.set_text(value.goal)
    ui.deadline_input.set_text(if value.deadline == nil { date_text(today_epoch() + 7 * 86400) } else { value.deadline.split("T")[0] })
    editing_goal = true; input_changed(); refresh()
}
fn toggle_view() {
    app_state.showingFormal = !app_state.showingFormal; refresh()
}
fn latest_persisted_business() {
    let record = read_record(saved_file)
    if record == nil { return nil }
    return record.business
}
fn verify_pending() {
    if busy or app_state.pendingVerification == nil { return }
    busy = true; app_state.phase = "verifying"
    if !save_business() { busy = false; refresh(); return }
    show_status("正在保存并核验完整日历"); refresh()
    # 待确认 target 写入文件后重新读取，核验使用这次回读的数据。
    let readback = latest_persisted_business()
    if readback == nil {
        storage_error = "本地记录回读失败"
        app_state.phase = "confirm_failed"; app_state.error = storage_error; busy = false
        show_status("本地记录回读失败：" + storage_error); refresh(); return
    }
    let pending = clone_value(readback.pendingVerification)
    let outcome = request_api("/v1/calendar/verify", {beforeSnapshot: pending.before, draftProject: pending.draft,
        plan: pending.plan, readbackSnapshot: pending.target, now: current_iso()}).await()
    let error = request_error(outcome)
    if error != "" {
        app_state.phase = "confirm_failed"; app_state.error = error
        let saved = save_business(); busy = false
        if saved { show_status("确认核验失败：" + error) }
        refresh(); return
    }
    let receipt = outcome.response.body.to_string().parse_json()
    if receipt.status != "verified" {
        app_state.phase = "confirm_failed"; app_state.error = receipt.reason
        let saved = save_business(); busy = false
        if saved { show_status("计划尚未确认：" + receipt.reason) }
        refresh(); return
    }
    # 正式项目、回执和清除候选作为一次保存；保存及回读成功后才更新正式项目。
    let next_state = clone_value(app_state)
    next_state.project = clone_value(pending.target); next_state.receipt = receipt
    next_state.savedAt = current_iso(); next_state.confirmedRationale = pending.plan.rationale
    next_state.formalCapacity = clone_value(next_state.capacity)
    next_state.confirmedRisks = pending.plan.risks; next_state.pendingVerification = nil
    next_state.plan = nil; next_state.draftProject = nil; next_state.phase = "confirmed"; next_state.error = ""
    next_state.showingFormal = false
    if !persist(next_state, current_draft(), true) {
        app_state.phase = "confirm_failed"; app_state.error = storage_error; busy = false
        show_status("正式计划保存失败：" + storage_error); refresh(); return
    }
    app_state = next_state
    project = clone_value(app_state.project); displayed = project
    busy = false; show_status("计划已确认，日历已保存并通过核验")
    refresh()
}
fn confirm_plan() {
    if busy or app_state.plan == nil { return }
    assert(app_state.plan.baseVersion == project.version)
    app_state.pendingVerification = {before: clone_value(project), draft: clone_value(app_state.draftProject),
        plan: clone_value(app_state.plan), target: plan_project(app_state.draftProject, app_state.plan), now: current_iso()}
    verify_pending()
}
fn load_persisted() {
    let path_a = "state-a.json"; let path_b = "state-b.json"
    let exists_a = fs.exists(path_a); let exists_b = fs.exists(path_b)
    if !exists_a and !exists_b { return {mode: "fresh", record: nil, file: "", message: ""} }
    let record_a = if exists_a { read_record(path_a) } else { nil }
    let record_b = if exists_b { read_record(path_b) } else { nil }
    let valid_a = record_a != nil; let valid_b = record_b != nil
    if valid_a and valid_b {
        if record_a.sequence == record_b.sequence {
            return {mode: "stopped", record: nil, file: "", message: "本地记录序号重复，停止初始化并保留文件"}
        }
        if record_a.sequence > record_b.sequence {
            return {mode: "recovered", record: record_a, file: path_a, message: ""}
        }
        return {mode: "recovered", record: record_b, file: path_b, message: ""}
    }
    if valid_a or valid_b {
        let interrupted = (exists_a and !valid_a) or (exists_b and !valid_b)
        let message = if interrupted { "检测到中断的保存，已恢复最近完整记录" } else { "" }
        if valid_a { return {mode: "recovered", record: record_a, file: path_a, message: message} }
        return {mode: "recovered", record: record_b, file: path_b, message: message}
    }
    return {mode: "stopped", record: nil, file: "", message: "本地记录全部无效，停止初始化并保留文件"}
}
fn boot() {
    let device = fs.read("device.json").parse_json()
    let recovered = load_persisted()
    if recovered.mode == "stopped" {
        # 记录全部无效时停止初始化，保留文件，只展示空白界面和明确提示。
        storage_error = recovered.message
        app_state.utcOffset = device.utcOffset; app_state.timezone = device.timezone
        if app_state.month == 0 { app_state.month = month_start(today_epoch()); app_state.selectedDay = today_epoch() }
        ui.timezone_label.set_text("设备时区 · " + app_state.timezone)
        show_status(recovered.message)
        refresh()
        return
    }
    if recovered.mode == "recovered" {
        app_state = clone_value(recovered.record.business)
        business_version = recovered.record.businessVersion
        saved_sequence = recovered.record.sequence; saved_file = recovered.file
    } else {
        app_state = default_state(); business_version = 0; saved_sequence = 0; saved_file = ""
    }
    # 设备时区属于本机，恢复业务记录之后应用，不被旧记录覆盖。
    app_state.utcOffset = device.utcOffset; app_state.timezone = device.timezone
    if !has_field(app_state, "questionId") or app_state.questionId == "" { app_state.questionId = "initial" }
    project = clone_value(app_state.project)
    draft_question = app_state.questionId
    draft_revision = 0
    draft_goal = ""
    draft_deadline = date_text(today_epoch() + 7 * 86400)
    draft_answer = ""
    if recovered.mode == "recovered" {
        let draft = recovered.record.draft
        draft_revision = draft.revision
        # 新问题只恢复该 questionId 的草稿。
        if draft.questionId == app_state.questionId and draft.projectId == project.id {
            draft_goal = draft.goal; draft_deadline = draft.deadline; draft_answer = draft.answer
        }
    }
    if app_state.month == 0 { app_state.month = month_start(today_epoch()); app_state.selectedDay = today_epoch() }
    ui.goal_input.set_text(draft_goal); ui.deadline_input.set_text(draft_deadline)
    ui.advice_input.set_text(draft_answer)
    ui.timezone_label.set_text("设备时区 · " + app_state.timezone)
    loaded = true; editing_goal = project.goal == "" and app_state.draftProject == nil and app_state.lastRequest == nil
    if recovered.mode == "fresh" {
        if !save_business() { loaded = false; return }
        show_status("已初始化本地记录")
    } elif recovered.message != "" { show_status(recovered.message) }
    elif app_state.pendingVerification != nil { app_state.phase = "confirm_failed"; show_status("候选计划已经保存，请重新确认核验") }
    elif app_state.plan != nil { show_status("已恢复候选计划与正式日历") }
    elif project.tasks.len() > 0 { show_status("已恢复本地日历") }
    refresh()
    if app_state.activeJob != nil { busy = true; progress_text = "正在恢复规划过程"; refresh(); poll_planning() }
    elif app_state.phase == "generating" or app_state.phase == "revising" { planning_failed("规划请求尚未提交，请重新生成") }
}

start_timeout(0.05, || boot())

SolidView{width: Fill height: Fill flow: Down draw_bg.color: #xf5f7f6
    SolidView{width: Fill height: 72 flow: Right padding: Inset{left: 40 right: 40} spacing: 16 align: Align{y: 0.5} draw_bg.color: #xffffff
        RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: brand border_radius: 8}
            Text{text: "L" draw_text +: {color: #xffffff text_style: english{font_size: 17.25}}}
        }
        Text{text: "Loom" draw_text.text_style: english}
        Text{text: "目标与日历" draw_text.color: muted}
        View{width: Fill height: 1}
        timezone_label := Small{text: "设备时区"}
        RoundedView{width: Fit height: 28 padding: Inset{left: 12 right: 12} align: Align{y: 0.5} draw_bg +: {color: brand_soft border_radius: 8}
            Small{text: "本地日历" draw_text.color: brand}
        }
    }
    ScrollXYView{width: Fill height: Fill flow: Down
        View{width: 1440 height: Fit flow: Down padding: Inset{left: 40 right: 40 top: 28 bottom: 32} spacing: 24
            page_heading := View{width: Fill height: 44 flow: Right align: Align{y: 0.5} on_render: || {
                Heading{text: if displayed.goal == "" { "把目标安排进每一天" } else { "你的月历" } draw_text.text_style.font_size: 21}
                View{width: Fill height: 1}
                Text{text: "今天 · " + date_text(today_epoch()) draw_text.color: muted}
            }}
            Card{spacing: 8
                goal_form := View{width: Fill height: Fit flow: Down spacing: 8
                    View{width: Fill height: 76 flow: Right spacing: 24 align: Align{y: 1}
                        View{width: Fill height: Fit flow: Down spacing: 8
                            Text{text: "你的目标"}
                            goal_input := Input{empty_text: "例如：完成 Loom 的演示与使用文档" on_change: |text| input_changed()}
                        }
                        View{width: 220 height: Fit flow: Down spacing: 8
                            Text{text: "截止日期"}
                            deadline_input := Input{empty_text: "YYYY-MM-DD" on_change: |text| input_changed()}
                        }
                        generate_action := View{width: 140 height: 40 on_render: || {
                            Action{width: Fill text: "生成计划" enabled: loaded and !busy and draft_goal.trim() != ""
                                on_click: || generate_plan()}
                        }}
                    }
                    Small{text: "截止日期默认为七天后 · 工作时间：周一至周五 09:00–18:00"}
                }
                goal_summary := View{width: Fill height: Fit flow: Right spacing: 24 visible: false align: Align{y: 0.5} on_render: || {
                    let value = if app_state.showingFormal { project } elif app_state.draftProject != nil { app_state.draftProject } elif app_state.lastRequest != nil and project.goal == "" { app_state.lastRequest.snapshot } else { project }
                    View{width: Fill height: Fit flow: Down spacing: 6
                        Heading{width: Fill text: value.goal}
                        Small{text: (if value.deadline == nil { "" } else { "截止日期 · " + value.deadline.split("T")[0] + " 18:00    " }) + "周一至周五 09:00–18:00"}
                    }
                    Subtle{text: "编辑目标" enabled: !busy on_click: || edit_goal()}
                }}
                status_label := Small{width: Fill max_lines: 2 text_overflow: mod.text.TextOverflow.Ellipsis text: status_text visible: false}
            }
            view_banner := View{width: Fill height: Fit flow: Down on_render: || {
                if app_state.plan != nil and project.tasks.len() > 0 {
                    RoundedView{width: Fill height: 44 flow: Right padding: Inset{left: 16 right: 8} align: Align{y: 0.5} draw_bg +: {color: purple_soft border_radius: 8}
                        Text{text: if app_state.showingFormal { "正在查看已确认计划" } else { "正在查看候选计划 · 正式安排已保留" } draw_text.color: purple}
                        View{width: Fill height: 1}
                        Subtle{text: if app_state.showingFormal { "查看候选计划" } else { "查看已确认计划" } on_click: || toggle_view()}
                    }
                }
            }}
            View{width: Fill height: Fit flow: Right spacing: 24
                View{width: 1008 height: Fit flow: Down spacing: 16
                    Card{padding: 0 spacing: 0
                        month_header := View{width: Fill height: 64 flow: Right padding: Inset{left: 24 right: 24} spacing: 8 align: Align{y: 0.5} on_render: || {
                            let parts = local_time(app_state.month)
                            month_label := Heading{text: "" + parts.year + "年 " + parts.month + "月" draw_text.text_style.font_size: 18}
                            View{width: Fill height: 1}
                            Subtle{text: "上个月" on_click: || change_month(-1)}
                            Subtle{text: "今天" on_click: || select_today()}
                            Subtle{text: "下个月" on_click: || change_month(1)}
                        }}
                        View{width: Fill height: 32 flow: Right
                            for day in ["周一", "周二", "周三", "周四", "周五", "周六", "周日"] {
                                View{width: 144 height: 32 align: Align{x: 0.5 y: 0.5} Small{text: day}}
                            }
                        }
                        calendar_grid := View{width: Fill height: Fit flow: Down on_render: || {
                            let lead = (local_time(app_state.month).weekday + 6) % 7
                            let days = (next_month(app_state.month) - app_state.month) / 86400
                            let rows = ceil((lead + days) / 7)
                            for row in rows {
                                View{width: Fill height: 120 flow: Right
                                    for column in 7 {
                                        let epoch = app_state.month + (row * 7 + column - lead) * 86400
                                        let parts = local_time(epoch)
                                        let outside = month_start(epoch) != app_state.month
                                        let today = epoch == today_epoch()
                                        let due = displayed.deadline != nil and date_text(epoch) == displayed.deadline.split("T")[0]
                                        let selected = epoch == app_state.selectedDay
                                        let rows = day_items(epoch)
                                        GestureView{width: 144 height: 120 on_tap: |x, y| select_day(epoch)
                                            RoundedView{width: Fill height: Fill flow: Down padding: Inset{left: 8 right: 8 top: 6 bottom: 6} spacing: 2
                                                draw_bg +: {color: if selected { brand_soft } elif outside or column >= 5 { #xf5f7f6 } else { #xffffff }
                                                    border_color: if today or selected { brand } elif due { gold } else { line } border_size: 1 border_radius: 0}
                                                View{width: Fill height: 24 flow: Right spacing: 8 align: Align{y: 0.5}
                                                    RoundedView{width: 24 height: 24 align: Align{x: 0.5 y: 0.5}
                                                        draw_bg +: {color: if today { brand } elif due { gold_soft } else { #x00000000 } border_radius: 12}
                                                        date_number := Small{text: padded(parts.day) draw_text +: {text_style: chinese_medium{font_size: 9} color: if today { #xffffff } elif due { gold } elif outside { faint } else { ink }}}
                                                    }
                                                    Small{text: if today { "今天" } elif due { "截止" } elif outside { "" + parts.month + "月" } else { "" } draw_text.text_style.font_size: 7.5}
                                                }
                                                for index in min(rows.len(), 2) {
                                                    let item = rows[index]
                                                    RoundedView{width: Fill height: 32 flow: Down padding: Inset{left: 4 right: 4 top: 2 bottom: 2}
                                                        draw_bg +: {color: if item.fixed { #xeff2f1 } elif app_state.plan != nil and !app_state.showingFormal { purple_soft } else { brand_soft } border_radius: 8}
                                                        Small{height: 12 text: clock_text(item.start) + "–" + clock_text(item.end) draw_text.text_style.font_size: 7.5
                                                            draw_text.color: if item.fixed { fixed_ink } elif app_state.plan != nil and !app_state.showingFormal { purple } else { brand }}
                                                        Small{width: Fill height: 16 max_lines: 1 text_overflow: mod.text.TextOverflow.Ellipsis text: item.title
                                                            draw_text +: {text_style: chinese_medium{font_size: 9} color: if item.fixed { fixed_ink } elif app_state.plan != nil and !app_state.showingFormal { purple } else { brand }}}
                                                    }
                                                }
                                                if rows.len() > 2 { Small{text: "还有 " + (rows.len() - 2) + " 项安排" draw_text.text_style.font_size: 7.5} }
                                            }
                                        }
                                    }
                                }
                            }
                        }}
                        calendar_legend := View{width: Fill height: 40 flow: Right padding: Inset{left: 24 right: 24} spacing: 24 align: Align{y: 0.5} on_render: || {
                            Small{text: "● 已确认安排" draw_text.color: brand}
                            if app_state.plan != nil { Small{text: "● 候选安排" draw_text.color: purple} }
                            Small{text: "● 固定或已开始安排"}
                            Small{text: "● 截止日期" draw_text.color: gold}
                        }}
                    }
                    day_detail := Card{on_render: || {
                        let parts = local_time(app_state.selectedDay); let rows = day_items(app_state.selectedDay); let hours = 0
                        for item in rows { hours = hours + (item.end - item.start) / 3600 }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                            Heading{text: "" + parts.month + "月" + parts.day + "日 · " + ["周日", "周一", "周二", "周三", "周四", "周五", "周六"][parts.weekday]}
                            View{width: Fill height: 1}
                            Small{text: "" + rows.len() + " 项安排 · " + hours + " 小时"}
                        }
                        if rows.len() == 0 { Text{text: "当天暂无安排，选择日期查看完整日程。" draw_text.color: muted} }
                        for item in rows {
                            View{width: Fill height: Fit flow: Right spacing: 16
                                Text{width: 110 text: clock_text(item.start) + "–" + clock_text(item.end) draw_text.color: muted}
                                View{width: Fill height: Fit flow: Down spacing: 4
                                    Text{width: Fill text: item.title}
                                    if item.taskId != nil {
                                        let task = task_by_id(displayed, item.taskId)
                                        let dependencies = ""
                                        for identifier in task.dependsOn { dependencies = dependencies + (if dependencies == "" { "" } else { "、" }) + task_by_id(displayed, identifier).title }
                                        if dependencies != "" { Small{width: Fill text: "依赖：" + dependencies} }
                                    }
                                }
                                Small{text: if item.done { "已完成" } elif item.fixed { "固定安排" } elif app_state.plan != nil and !app_state.showingFormal { "待确认" } else { "已确认" }
                                    draw_text.color: if item.fixed { muted } elif app_state.plan != nil and !app_state.showingFormal { purple } else { brand }}
                            }
                        }
                    }}
                }
                View{width: 328 height: Fit flow: Down spacing: 16
                    plan_summary := Card{on_render: || {
                        if busy {
                            Small{text: if app_state.phase == "verifying" { "保存核验中" } elif app_state.phase == "generating" { "正在生成" } else { "正在修改" } draw_text.color: purple}
                            Heading{width: Fill text: if app_state.phase == "verifying" { "正在保存并核验" } else { "正在安排你的目标" }}
                            Text{width: Fill text: if app_state.phase == "verifying" { "核验任务工时、依赖和保存内容，随后更新正式日历。" } else { progress_text } draw_text.color: muted}
                        } elif app_state.phase == "failed" or app_state.phase == "confirm_failed" {
                            Small{text: "需要重新处理" draw_text.color: gold}
                            Heading{width: Fill text: if app_state.phase == "confirm_failed" { "计划尚未确认" } else { "本次规划已停止" }}
                            Text{width: Fill max_lines: 6 text_overflow: mod.text.TextOverflow.Ellipsis text: app_state.error draw_text.color: muted}
                            if app_state.phase == "confirm_failed" { Action{width: Fill text: "重新确认计划" on_click: || verify_pending()} }
                            else { Action{width: Fill text: "重新生成计划" on_click: || retry_planning()} }
                        } elif app_state.phase == "clarify" {
                            Small{text: "需要补充说明" draw_text.color: purple}
                            Heading{text: "请补充你的选择"}
                            Text{width: Fill text: app_state.question}
                        } elif displayed.tasks.len() > 0 {
                            let candidate = app_state.plan != nil and !app_state.showingFormal
                            Small{text: if candidate { "候选计划 · 待确认" } else { "计划已确认" } draw_text.color: if candidate { purple } else { brand }}
                            Heading{text: if candidate { "你的计划已准备好" } else { "安排已保存到日历" }}
                            View{width: Fill height: Fit flow: Right spacing: 8
                                View{width: 82 height: Fit flow: Down spacing: 4 Heading{text: "" + displayed.tasks.len() draw_text.text_style.font_size: 18} Small{text: "项任务"}}
                                View{width: 82 height: Fit flow: Down spacing: 4 Heading{text: "" + total_hours(displayed) draw_text.text_style.font_size: 18} Small{text: "小时"}}
                                View{width: 82 height: Fit flow: Down spacing: 4
                                    Heading{text: short_deadline(displayed) draw_text.text_style.font_size: 18}
                                    Small{text: "截止日期"}
                                }
                            }
                            Text{width: Fill text: if candidate { app_state.plan.rationale } else { app_state.confirmedRationale } draw_text.color: muted}
                            let finish = latest_end(displayed)
                            if finish > 0 {
                                Small{width: Fill text: "预计完成 · " + date_text(finish) + " " + clock_text(finish)}
                                if displayed.deadline != nil {
                                    let hours = (app_state.calendar[displayed.deadline] - finish) / 3600
                                    Small{width: Fill text: if hours >= 0 { "期限余量 · " + floor(hours / 24) + " 天 " + floor(hours % 24) + " 小时" } else { "预计超期 · " + ceil(-hours) + " 小时" }
                                        draw_text.color: if hours >= 0 { muted } else { gold }}
                                }
                            }
                            if candidate {
                                Action{width: Fill text: if project.tasks.len() > 0 { "确认修改后的计划" } else { "确认计划" } on_click: || confirm_plan()}
                            } else { Small{width: Fill text: "保存核验通过 · " + app_state.savedAt.replace("T", " ") draw_text.color: brand} }
                        } else {
                            Small{text: "等待你的目标" draw_text.color: brand}
                            Heading{text: "从一个目标开始"}
                            Text{width: Fill text: "填写你想完成的事情与截止日期，Loom 会拆分任务，并将每日安排放进月历。" draw_text.color: muted}
                        }
                    }}
                    risk_panel := View{width: Fill height: Fit flow: Down on_render: || {
                        let info = capacity_info()
                        Card{draw_bg +: {color: if info.warning { gold_soft } else { brand_soft } border_color: if info.warning { gold_line } else { line }}
                            Heading{text: info.title draw_text +: {color: if info.warning { gold } else { brand } text_style.font_size: 12}}
                            Text{width: Fill text: info.text draw_text.color: muted}
                            for entry in info.risks { Small{width: Fill text: entry draw_text.color: gold} }
                        }
                    }}
                    modification := Card{visible: false
                        Heading{text: "想调整安排？"}
                        Text{width: Fill text: "写下你的建议，Loom 会调整任务与时间，生成新的候选计划供你确认。" draw_text.color: muted}
                        advice_input := Input{height: 116 is_multiline: true empty_text: "例如：把演示文档提前，增加半小时检查时间" on_change: |text| advice_changed(text)}
                        revision_action := View{width: Fill height: 40 on_render: || {
                            Action{width: Fill text: if app_state.phase == "clarify" { "提交回答并继续" } else { "根据建议修改" }
                                enabled: loaded and !busy and draft_answer.trim() != "" on_click: || revise_plan()}
                        }}
                    }
                }
            }
        }
    }
}
