+#[cfg(test)]
+mod memory_telemetry_tests {
+    use super::*;
+    use crate::makepad_platform::log::{set_log_tap, LogLevel};
+    use std::sync::Mutex;
+
+    /// The tests below touch the process-wide gate and tap; run them one at a
+    /// time so none sees another's environment or captured lines.
+    static LOCK: Mutex<()> = Mutex::new(());
+    static CAPTURED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+    fn capture(message: &str, _level: LogLevel) {
+        CAPTURED.lock().unwrap().push(message.to_string());
+    }
+
+    fn telemetry_lines() -> Vec<String> {
+        CAPTURED
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|line| line.contains("\"kind\":\"loom.memory.entry\""))
+            .cloned()
+            .collect()
+    }
+
+    fn field(line: &str, name: &str) -> u64 {
+        let marker = format!("\"{name}\":");
+        let start = line.find(&marker).expect("telemetry field") + marker.len();
+        let rest = &line[start..];
+        let end = rest
+            .find(|c: char| !c.is_ascii_digit())
+            .unwrap_or(rest.len());
+        rest[..end].parse().expect("telemetry number")
+    }
+
+    /// A few input-style string concatenations, so the entry allocates a real
+    /// amount and leaves the reuse pool with work to do.
+    fn allocate_probe_strings(vm: &mut ScriptVm) {
+        vm.eval(crate::makepad_script::script! {
+            let s = ""
+            for i in 0..40 { s = s + "xxxxxxxxxx" }
+            s
+        });
+    }
+
+    /// The projection is pure: the numbers in, the same numbers out.
+    #[test]
+    fn telemetry_json_reports_the_interval() {
+        let before = ScriptHeapMemoryStats {
+            retained_bytes: 4096,
+            allocated_total_bytes: 1000,
+            collections: 2,
+            reuse_buffers: 3,
+            reuse_bytes: 96,
+            ..Default::default()
+        };
+        let after = ScriptHeapMemoryStats {
+            retained_bytes: 5120,
+            allocated_total_bytes: 1750,
+            collections: 3,
+            reuse_buffers: 4,
+            reuse_bytes: 128,
+            ..Default::default()
+        };
+        let line = memory_telemetry_json(SplashVmId(7), before, after);
+        assert_eq!(field(&line, "vm"), 7, "{line}");
+        assert_eq!(field(&line, "retainedBefore"), 4096, "{line}");
+        assert_eq!(field(&line, "retainedAfter"), 5120, "{line}");
+        assert_eq!(field(&line, "allocatedBytes"), 750, "{line}");
+        assert_eq!(field(&line, "collectionsBefore"), 2, "{line}");
+        assert_eq!(field(&line, "collectionsAfter"), 3, "{line}");
+        assert_eq!(field(&line, "reuseBuffersBefore"), 3, "{line}");
+        assert_eq!(field(&line, "reuseBuffersAfter"), 4, "{line}");
+        assert_eq!(field(&line, "reuseBytesBefore"), 96, "{line}");
+        assert_eq!(field(&line, "reuseBytesAfter"), 128, "{line}");
+    }
+
+    /// The gate is exactly the host's environment variable.
+    #[test]
+    fn telemetry_gate_follows_the_environment() {
+        let _guard = LOCK.lock().unwrap();
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+        assert!(!memory_telemetry_enabled());
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "1");
+        assert!(memory_telemetry_enabled());
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "0");
+        assert!(!memory_telemetry_enabled());
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+    }
+
+    /// Disabled entries write nothing; an enabled entry writes one line with
+    /// the VM id and real allocation counters.
+    #[test]
+    fn telemetry_logs_one_line_per_enabled_entry() {
+        let _guard = LOCK.lock().unwrap();
+        CAPTURED.lock().unwrap().clear();
+        set_log_tap(Some(capture));
+
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.with_vm(crate::script_mod);
+        let vm_id = cx.alloc_splash_vm();
+
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        assert!(telemetry_lines().is_empty(), "disabled writes nothing");
+
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "1");
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        let lines = telemetry_lines();
+        assert!(!lines.is_empty(), "an enabled entry writes a line");
+        assert!(
+            lines.iter().any(|line| line.contains(&format!("\"vm\":{}", vm_id.0))),
+            "{lines:?}"
+        );
+        assert!(
+            lines.iter().any(|line| field(line, "allocatedBytes") > 0),
+            "{lines:?}"
+        );
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+
+        set_log_tap(None);
+        cx.free_splash_vm(vm_id);
+    }
+
+    /// A collection between two entries must not hide the second's allocation
+    /// delta: the lifetime counter survives the sweep.
+    #[test]
+    fn telemetry_measures_allocation_across_a_collection() {
+        let _guard = LOCK.lock().unwrap();
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.with_vm(crate::script_mod);
+        let vm_id = cx.alloc_splash_vm();
+
+        let before =
+            cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.memory_stats().allocated_total_bytes);
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        let after_first =
+            cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.memory_stats().allocated_total_bytes);
+        assert!(after_first > before, "the loop charged bytes");
+
+        cx.with_script_vm_id(vm_id, |vm| vm.gc());
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        let after_second =
+            cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.memory_stats().allocated_total_bytes);
+        assert!(
+            after_second > after_first,
+            "the lifetime total did not reset at the collection"
+        );
+
+        cx.free_splash_vm(vm_id);
+    }
+
+    /// A real `Splash` body that builds a growing string is one telemetry entry
+    /// with a real allocation delta.
+    #[test]
+    fn telemetry_records_a_splash_string_entry() {
+        use crate::widget_tree::set_ui_root;
+
+        let _guard = LOCK.lock().unwrap();
+        CAPTURED.lock().unwrap().clear();
+        set_log_tap(Some(capture));
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "1");
+
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let template = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let v = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                use mod.widgets.*
+                View{ splash := Splash{} }
+            });
+            let obj = v.as_object().expect("template did not eval to an object");
+            vm.bx.heap.new_object_ref(obj)
+        });
+        let pane = cx.with_vm(|vm| {
+            let v = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                View{ height: Fit }
+            });
+            WidgetRef::script_from_value(vm, v)
+        });
+        set_ui_root(&mut cx, &pane);
+        let host = cx.with_vm(|vm| WidgetRef::script_from_value(vm, template.as_object().into()));
+        cx.widget_tree_insert_child_deep(pane.widget_uid(), live_id!(apphost), host.clone());
+        let splash = host.widget(&cx, &[live_id!(splash)]);
+        splash.set_text(
+            &mut cx,
+            "let s = \"\"\nfor i in 0..40 { s = s + \"xxxxxxxxxx\" }\nLabel{text: s}",
+        );
+
+        let lines = telemetry_lines();
+        assert!(!lines.is_empty(), "a Splash entry writes telemetry");
+        assert!(
+            lines.iter().any(|line| field(line, "allocatedBytes") > 0),
+            "{lines:?}"
+        );
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+        set_log_tap(None);
+    }
+}
