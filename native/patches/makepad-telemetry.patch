+#[cfg(test)]
+mod memory_telemetry_tests {
+    use super::*;
+    use crate::makepad_platform::log::{set_log_tap, LogLevel};
+    use std::sync::{Mutex, MutexGuard};
+
+    /// 以下测试都会改动进程级的环境变量与日志捕获；用锁串行执行，
+    /// 避免相互看到对方的环境值或捕获行。
+    static LOCK: Mutex<()> = Mutex::new(());
+    static CAPTURED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+    fn capture(message: &str, _level: LogLevel) {
+        CAPTURED.lock().unwrap().push(message.to_string());
+    }
+
+    /// 进入测试时安装日志捕获并记录原环境变量；离开作用域时关闭捕获并
+    /// 恢复原值，即使测试失败也不会影响后续测试。
+    struct CaptureGuard {
+        _lock: MutexGuard<'static, ()>,
+        previous: Option<String>,
+    }
+
+    impl CaptureGuard {
+        fn enter() -> CaptureGuard {
+            let lock = LOCK.lock().unwrap();
+            let previous = std::env::var("LOOM_MEMORY_TELEMETRY").ok();
+            CAPTURED.lock().unwrap().clear();
+            set_log_tap(Some(capture));
+            CaptureGuard { _lock: lock, previous }
+        }
+    }
+
+    impl Drop for CaptureGuard {
+        fn drop(&mut self) {
+            set_log_tap(None);
+            match &self.previous {
+                Some(value) => std::env::set_var("LOOM_MEMORY_TELEMETRY", value),
+                None => std::env::remove_var("LOOM_MEMORY_TELEMETRY"),
+            }
+        }
+    }
+
+    /// 已捕获的遥测行，用 serde_json 解析而不是手动截取字符串。
+    fn telemetry_lines() -> Vec<serde_json::Value> {
+        CAPTURED
+            .lock()
+            .unwrap()
+            .iter()
+            .filter_map(|line| serde_json::from_str::<serde_json::Value>(line).ok())
+            .filter(|value| {
+                value.get("kind").and_then(|kind| kind.as_str()) == Some("loom.memory.entry")
+            })
+            .collect()
+    }
+
+    fn field(value: &serde_json::Value, name: &str) -> u64 {
+        value[name].as_u64().expect("遥测数字")
+    }
+
+    /// 反复拼接字符串，产生真实的输入型分配，并让复用池有内容。
+    fn allocate_probe_strings(vm: &mut ScriptVm) {
+        vm.eval(crate::makepad_script::script! {
+            let s = ""
+            for i in 0..40 { s = s + "xxxxxxxxxx" }
+            s
+        });
+    }
+
+    /// 投影是纯函数：输入的数字原样出现在输出里。
+    #[test]
+    fn telemetry_json_reports_the_interval() {
+        let before = ScriptHeapMemoryStats {
+            retained_bytes: 4096,
+            allocated_total_bytes: 1000,
+            collections: 2,
+            reuse_buffers: 3,
+            reuse_bytes: 96,
+            ..Default::default()
+        };
+        let after = ScriptHeapMemoryStats {
+            retained_bytes: 5120,
+            allocated_total_bytes: 1750,
+            collections: 3,
+            reuse_buffers: 4,
+            reuse_bytes: 128,
+            ..Default::default()
+        };
+        let line = memory_telemetry_json(SplashVmId(7), before, after);
+        let value: serde_json::Value = serde_json::from_str(&line).expect("遥测 JSON 合法");
+        assert_eq!(field(&value, "vm"), 7, "{line}");
+        assert_eq!(field(&value, "retainedBefore"), 4096, "{line}");
+        assert_eq!(field(&value, "retainedAfter"), 5120, "{line}");
+        assert_eq!(field(&value, "allocatedBytes"), 750, "{line}");
+        assert_eq!(field(&value, "collectionsBefore"), 2, "{line}");
+        assert_eq!(field(&value, "collectionsAfter"), 3, "{line}");
+        assert_eq!(field(&value, "reuseBuffersBefore"), 3, "{line}");
+        assert_eq!(field(&value, "reuseBuffersAfter"), 4, "{line}");
+        assert_eq!(field(&value, "reuseBytesBefore"), 96, "{line}");
+        assert_eq!(field(&value, "reuseBytesAfter"), 128, "{line}");
+    }
+
+    /// 门禁就是宿主设置的环境变量。
+    #[test]
+    fn telemetry_gate_follows_the_environment() {
+        let _guard = CaptureGuard::enter();
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+        assert!(!memory_telemetry_enabled());
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "1");
+        assert!(memory_telemetry_enabled());
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "0");
+        assert!(!memory_telemetry_enabled());
+    }
+
+    /// 未启用时不写任何行；启用时每个入口写一行，含 VM 标识与真实分配计数。
+    #[test]
+    fn telemetry_logs_one_line_per_enabled_entry() {
+        let _guard = CaptureGuard::enter();
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.with_vm(crate::script_mod);
+        let vm_id = cx.alloc_splash_vm();
+
+        std::env::remove_var("LOOM_MEMORY_TELEMETRY");
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        assert!(telemetry_lines().is_empty(), "未启用时不写日志");
+
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "1");
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        let lines = telemetry_lines();
+        assert!(!lines.is_empty(), "启用时写一行");
+        assert!(lines.iter().any(|line| field(line, "vm") == vm_id.0), "{lines:?}");
+        assert!(
+            lines.iter().any(|line| field(line, "allocatedBytes") > 0),
+            "{lines:?}"
+        );
+
+        cx.free_splash_vm(vm_id);
+    }
+
+    /// 两次入口之间的回收不能隐藏第二次的分配增量：终身计数跨 sweep 保留。
+    #[test]
+    fn telemetry_measures_allocation_across_a_collection() {
+        let _guard = CaptureGuard::enter();
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.with_vm(crate::script_mod);
+        let vm_id = cx.alloc_splash_vm();
+
+        let before =
+            cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.memory_stats().allocated_total_bytes);
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        let after_first =
+            cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.memory_stats().allocated_total_bytes);
+        assert!(after_first > before, "循环产生了分配");
+
+        cx.with_script_vm_id(vm_id, |vm| vm.gc());
+        cx.with_script_vm_id(vm_id, allocate_probe_strings);
+        let after_second =
+            cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.memory_stats().allocated_total_bytes);
+        assert!(after_second > after_first, "终身计数没有在回收时清零");
+
+        cx.free_splash_vm(vm_id);
+    }
+
+    /// 真实 `Splash` 运行拼接字符串的 body，会产生带真实分配增量的遥测行。
+    #[test]
+    fn telemetry_records_a_splash_string_entry() {
+        use crate::widget_tree::set_ui_root;
+
+        let _guard = CaptureGuard::enter();
+        std::env::set_var("LOOM_MEMORY_TELEMETRY", "1");
+
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let template = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let v = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                use mod.widgets.*
+                View{ splash := Splash{} }
+            });
+            let obj = v.as_object().expect("template did not eval to an object");
+            vm.bx.heap.new_object_ref(obj)
+        });
+        let pane = cx.with_vm(|vm| {
+            let v = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                View{ height: Fit }
+            });
+            WidgetRef::script_from_value(vm, v)
+        });
+        set_ui_root(&mut cx, &pane);
+        let host = cx.with_vm(|vm| WidgetRef::script_from_value(vm, template.as_object().into()));
+        cx.widget_tree_insert_child_deep(pane.widget_uid(), live_id!(apphost), host.clone());
+        let splash = host.widget(&cx, &[live_id!(splash)]);
+        splash.set_text(
+            &mut cx,
+            "let s = \"\"\nfor i in 0..40 { s = s + \"xxxxxxxxxx\" }\nLabel{text: s}",
+        );
+
+        let lines = telemetry_lines();
+        assert!(!lines.is_empty(), "Splash 入口写遥测");
+        assert!(
+            lines.iter().any(|line| field(line, "allocatedBytes") > 0),
+            "{lines:?}"
+        );
+    }
+}
