+/// 宿主是否要求逐入口内存统计；默认关闭，普通运行不写日志。
+fn memory_telemetry_enabled() -> bool {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::env::var("LOOM_MEMORY_TELEMETRY").as_deref() == Ok("1")
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        false
+    }
+}
+
+/// 一次遥测入口写的一条结构化 JSON：VM 标识与堆自身的计数，只有数字。
+/// 不包含脚本值、用户输入、恢复凭据或网络正文。
+fn memory_telemetry_json(vm_id: SplashVmId, before: ScriptHeapMemoryStats, after: ScriptHeapMemoryStats) -> String {
+    let allocated = after.allocated_total_bytes.saturating_sub(before.allocated_total_bytes);
+    serde_json::json!({
+        "kind": "loom.memory.entry",
+        "vm": vm_id.0,
+        "retainedBefore": before.retained_bytes,
+        "retainedAfter": after.retained_bytes,
+        "allocatedBytes": allocated,
+        "collectionsBefore": before.collections,
+        "collectionsAfter": after.collections,
+        "reuseBuffersBefore": before.reuse_buffers,
+        "reuseBuffersAfter": after.reuse_buffers,
+        "reuseBytesBefore": before.reuse_bytes,
+        "reuseBytesAfter": after.reuse_bytes,
+    })
+    .to_string()
+}
+
+/// 宿主要求时才写一条遥测日志；未启用时不做任何事。
+fn log_memory_telemetry(vm_id: SplashVmId, before: ScriptHeapMemoryStats, after: ScriptHeapMemoryStats) {
+    if memory_telemetry_enabled() {
+        crate::makepad_platform::log!("{}", memory_telemetry_json(vm_id, before, after));
+    }
+}
