+    #[test]
+    fn allocated_total_bytes_is_monotonic_across_collections() {
+        let mut heap = ScriptHeap::empty();
+        // Building the module namespace already charged the heap.
+        let start = heap.memory_stats().allocated_total_bytes;
+        assert!(start > 0);
+
+        assert!(heap.charge_allocation(1000, "test charge"));
+        assert_eq!(heap.memory_stats().allocated_total_bytes, start + 1000);
+
+        // A collection clears the since-GC signal but never the lifetime total.
+        heap.sweep(false);
+        let after_gc = heap.memory_stats();
+        assert_eq!(after_gc.allocated_since_gc_bytes, 0);
+        assert_eq!(after_gc.allocated_total_bytes, start + 1000);
+
+        assert!(heap.charge_allocation(24, "test charge"));
+        assert_eq!(heap.memory_stats().allocated_total_bytes, start + 1024);
+
+        // `usize::MAX` is the refusal sentinel, not payload.
+        assert!(heap.charge_allocation(usize::MAX, "sentinel"));
+        assert_eq!(heap.memory_stats().allocated_total_bytes, start + 1024);
+    }
