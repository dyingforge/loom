+/// Whether the host asked for per-entry memory telemetry. Off by default, so
+/// a normal run logs nothing.
+fn memory_telemetry_enabled() -> bool {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::env::var("LOOM_MEMORY_TELEMETRY").as_deref() == Ok("1")
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        false
+    }
+}
+
+/// The one structured line a telemetry entry writes: VM id and the heap's own
+/// counters, numbers only. It never carries script values, user input, resume
+/// tokens or network bodies.
+fn memory_telemetry_json(vm_id: SplashVmId, before: ScriptHeapMemoryStats, after: ScriptHeapMemoryStats) -> String {
+    let allocated = after.allocated_total_bytes.saturating_sub(before.allocated_total_bytes);
+    format!(
+        "{{\"kind\":\"loom.memory.entry\",\"vm\":{},\"retainedBefore\":{},\"retainedAfter\":{},\"allocatedBytes\":{},\"collectionsBefore\":{},\"collectionsAfter\":{},\"reuseBuffersBefore\":{},\"reuseBuffersAfter\":{},\"reuseBytesBefore\":{},\"reuseBytesAfter\":{}}}",
+        vm_id.0,
+        before.retained_bytes,
+        after.retained_bytes,
+        allocated,
+        before.collections,
+        after.collections,
+        before.reuse_buffers,
+        after.reuse_buffers,
+        before.reuse_bytes,
+        after.reuse_bytes,
+    )
+}
+
+/// Write one telemetry line when the host opted in. Cheap no-op when it did not.
+fn log_memory_telemetry(vm_id: SplashVmId, before: ScriptHeapMemoryStats, after: ScriptHeapMemoryStats) {
+    if memory_telemetry_enabled() {
+        crate::makepad_platform::log!("{}", memory_telemetry_json(vm_id, before, after));
+    }
+}
