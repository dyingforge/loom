+
+    fn host_with_splash(cx: &mut Cx) -> (WidgetRef, WidgetRef) {
+        let template = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let v = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                use mod.widgets.*
+                View{ splash := Splash{} }
+            });
+            let obj = v.as_object().expect("template did not eval to an object");
+            vm.bx.heap.new_object_ref(obj)
+        });
+        let pane = cx.with_vm(|vm| {
+            let v = vm.eval(crate::makepad_script::script! {
+                use mod.prelude.widgets.*
+                View{ height: Fit }
+            });
+            WidgetRef::script_from_value(vm, v)
+        });
+        set_ui_root(cx, &pane);
+        let host = cx.with_vm(|vm| WidgetRef::script_from_value(vm, template.as_object().into()));
+        cx.widget_tree_insert_child_deep(pane.widget_uid(), live_id!(apphost), host.clone());
+        (pane, host)
+    }
+
+    fn splash_of(host: &WidgetRef, cx: &Cx) -> WidgetRef {
+        host.widget(cx, &[live_id!(splash)])
+    }
+
+    /// A cap a sliver above what the isolate already holds: the next
+    /// script allocation larger than the sliver is refused.
+    fn cap_just_above(cx: &mut Cx, splash: &WidgetRef) -> usize {
+        let vm_id = splash.borrow::<Splash>().unwrap().vm_id;
+        let retained = cx.with_script_vm_id(vm_id, |vm| vm.bx.heap.retained_heap_bytes());
+        retained + 8 * 1024
+    }
+
+    /// A body whose `fn tick()` allocates 64 KiB in one string concat, and
+    /// arms the 1 Hz timer that fires it.
+    fn ticking_body() -> String {
+        let big = "x".repeat(64 * 1024);
+        format!("fn tick(){{ let s = \"\"; s = s + \"{big}\"; }}\nLabel{{text:\"app\"}}")
+    }
+
+    /// A body whose top-level allocates 80 KiB on every eval, so the style
+    /// reapply inside `draw_walk` refuses under a small cap.
+    fn redrawing_body() -> String {
+        let big = "x".repeat(40 * 1024);
+        format!("let junk = \"{big}\" + \"{big}\"\nLabel{{text:\"app\"}}")
+    }
+
+    /// Review point 1: a tick callback that refuses inside the event ends the
+    /// event on the spot — the error is installed and the old view never sees
+    /// the rest of it.
+    #[test]
+    fn a_tick_overflow_ends_its_event_in_the_same_frame() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let (_pane, host) = host_with_splash(&mut cx);
+        let splash = splash_of(&host, &cx);
+        splash.set_text(&mut cx, &ticking_body());
+        let timer = splash.borrow::<Splash>().unwrap().tick_timer;
+        assert!(!timer.is_empty(), "the tick timer is armed");
+        let cap = cap_just_above(&mut cx, &splash);
+        splash
+            .borrow_mut::<Splash>()
+            .unwrap()
+            .set_memory_bytes(&mut cx, Some(cap));
+
+        let event = Event::Timer(TimerEvent { time: Some(0.0), timer_id: timer.0 });
+        splash
+            .borrow_mut::<Splash>()
+            .unwrap()
+            .handle_event(&mut cx, &event, &mut Scope::empty());
+
+        let state = splash.borrow::<Splash>().unwrap();
+        assert!(state.memory_error().is_some(), "the same event showed the error");
+        assert_eq!(state.vm_id, MAIN_SPLASH_VM_ID, "and reclaimed the isolate");
+        drop(state);
+        assert!(
+            !splash
+                .borrow_mut::<Splash>()
+                .unwrap()
+                .call_script_fn(&mut cx, id!(tick), &[]),
+            "no further isolate callback runs"
+        );
+    }
+
+    /// Review point 2: a draw that refuses inside its own script pass shows
+    /// the error in the same frame, and the draw returns done rather than the
+    /// old view's step.
+    #[test]
+    fn a_draw_overflow_shows_the_error_in_the_same_frame() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let (_pane, host) = host_with_splash(&mut cx);
+        let splash = splash_of(&host, &cx);
+        splash.set_text(&mut cx, &redrawing_body());
+        let cap = cap_just_above(&mut cx, &splash);
+        splash
+            .borrow_mut::<Splash>()
+            .unwrap()
+            .set_memory_bytes(&mut cx, Some(cap));
+        // Force the style-reapply re-eval that `draw_walk` runs.
+        splash.borrow_mut::<Splash>().unwrap().style_pending = true;
+
+        let step = {
+            let event = DrawEvent::default();
+            let mut draw = CxDraw::new(&mut cx, &event);
+            let mut cx2d = Cx2d::new(&mut draw);
+            cx2d.begin_root_turtle(dvec2(320.0, 240.0), Layout::default());
+            let step = splash.borrow_mut::<Splash>().unwrap().draw_walk(
+                &mut cx2d,
+                &mut Scope::empty(),
+                Walk::fill(),
+            );
+            cx2d.end_turtle();
+            step
+        };
+
+        assert!(step.is_done(), "the draw stops after the refusal");
+        let state = splash.borrow::<Splash>().unwrap();
+        assert!(state.memory_error().is_some(), "the same frame showed the error");
+        assert_eq!(state.vm_id, MAIN_SPLASH_VM_ID, "and reclaimed the isolate");
+        drop(state);
+        assert!(
+            !splash
+                .borrow_mut::<Splash>()
+                .unwrap()
+                .call_script_fn(&mut cx, id!(tick), &[]),
+            "no further isolate callback runs"
+        );
+    }
+
+    /// Review point 3: a stopped instance refuses new script; reviving it is a
+    /// new `Splash`, not a `set_text` on the old one.
+    #[test]
+    fn a_stopped_instance_refuses_new_script() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let (_pane, host) = host_with_splash(&mut cx);
+        let splash = splash_of(&host, &cx);
+        splash.set_text(&mut cx, &ticking_body());
+        let cap = cap_just_above(&mut cx, &splash);
+        splash
+            .borrow_mut::<Splash>()
+            .unwrap()
+            .set_memory_bytes(&mut cx, Some(cap));
+        assert!(splash
+            .borrow_mut::<Splash>()
+            .unwrap()
+            .call_script_fn(&mut cx, id!(tick), &[]));
+        assert!(splash.borrow::<Splash>().unwrap().memory_error().is_some());
+        assert_eq!(splash.borrow::<Splash>().unwrap().vm_id, MAIN_SPLASH_VM_ID);
+
+        splash.set_text(&mut cx, "Label{text:\"restarted\"}");
+        let state = splash.borrow::<Splash>().unwrap();
+        assert!(state.memory_error().is_some(), "still stopped");
+        assert_eq!(state.vm_id, MAIN_SPLASH_VM_ID, "no isolate was allocated");
+        assert!(state.body.as_ref().is_empty(), "no new script was installed");
+    }
+}
