+/// Whether a stopped isolate's heap crossed its retained cap during the entry
+/// that just returned. On the first crossing, mark the heap terminated (every
+/// later callback, service and URL is refused) and record the numbers for the
+/// host's error view. Idempotent: only one termination is recorded.
+fn record_splash_heap_overflow(
+    cx: &mut Cx,
+    vm_id: SplashVmId,
+    isolated: &mut IsolatedSplashVm,
+    before: Option<(usize, usize)>,
+) {
+    let Some(bx) = isolated.vm.as_mut() else {
+        return;
+    };
+    let heap = &mut bx.heap;
+    let Some(limit) = heap.max_heap_bytes() else {
+        // No cap (the main VM or an uncapped isolate): drop any stale flag so
+        // it can never be misread as an overflow here.
+        heap.take_heap_limit_exceeded();
+        return;
+    };
+    let flagged = heap.take_heap_limit_exceeded();
+    if !flagged && heap.accounted_heap_bytes() <= limit {
+        return;
+    }
+    crate::splash_policy::mark_terminated(heap.heap_key());
+    let state = cx.global::<CxWidgetAsync>();
+    if state.terminated.contains_key(&vm_id) {
+        return;
+    }
+    let stats = heap.memory_stats();
+    let (reuse_buffers_before, collections_before) = before.unwrap_or((0, 0));
+    state.terminated.insert(
+        vm_id,
+        SplashTermination {
+            limit_bytes: limit,
+            retained_bytes: heap.accounted_heap_bytes(),
+            allocated_since_gc_bytes: stats.allocated_since_gc_bytes,
+            reuse_buffers_before,
+            reuse_buffers_after: stats.reuse_buffers,
+            reuse_bytes_after: stats.reuse_bytes,
+            collections_before,
+            collections_after: stats.collections,
+        },
+    );
+    crate::makepad_platform::error!(
+        "splash isolate {vm_id:?} stopped: heap cap {limit} bytes exceeded (retained {}, \
+         allocated since GC {}, reuse {}/{} bytes, collections {} -> {})",
+        heap.accounted_heap_bytes(),
+        stats.allocated_since_gc_bytes,
+        stats.reuse_buffers,
+        stats.reuse_bytes,
+        collections_before,
+        stats.collections,
+    );
+}
+
+/// Re-read an isolate left in the table by [`with_isolate`] (a host dispatch
+/// or draw) for an overflow, and record it. [`with_isolate_installed`] covers
+/// every `with_script_vm_id` entry; this covers the host's own entry.
+fn detect_splash_heap_overflow(cx: &mut Cx, vm_id: SplashVmId) {
+    if vm_id == MAIN_SPLASH_VM_ID {
+        return;
+    }
+    let mut isolated = match cx.global::<CxWidgetAsync>().isolated_vms.vms.remove(&vm_id) {
+        Some(isolated) => isolated,
+        None => return,
+    };
+    record_splash_heap_overflow(cx, vm_id, &mut isolated, None);
+    cx.global::<CxWidgetAsync>()
+        .isolated_vms
+        .vms
+        .insert(vm_id, isolated);
+}
