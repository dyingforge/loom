+/// Take the recorded termination for `vm_id`, if any. The host consumes it
+/// once when it replaces the isolate's view and reclaims the isolate.
+pub(crate) fn take_splash_termination(cx: &mut Cx, vm_id: SplashVmId) -> Option<SplashTermination> {
+    cx.global::<CxWidgetAsync>().terminated.remove(&vm_id)
+}
