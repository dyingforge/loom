diff --git a/crates/card-host/src/state.rs b/crates/card-host/src/state.rs
new file mode 100644
index 0000000..d715cbc
--- /dev/null
+++ b/crates/card-host/src/state.rs
@@ -0,0 +1,1315 @@
+//! The app's own business state, kept in SQLite behind a host-owned loopback
+//! service.
+//!
+//! A contained app cannot open a database, and its isolate's script runs under
+//! a jail and a storage quota. The host therefore serves the app's state the
+//! same way it serves the app's artwork: a loopback HTTP endpoint bound to a
+//! kernel-picked port, reachable only through the isolate's host allowlist, and
+//! named by a per-process random path credential that the host injects into the
+//! script as `{{state}}`. The credential is never logged.
+//!
+//! One worker thread owns one `rusqlite` connection and handles one request at a
+//! time, so every write is a transaction in arrival order and nothing races.
+//! The protocol is fixed:
+//!
+//! * `GET  <state>/v1/state?projectId=…` → `{version, business, draft}`
+//! * `POST <state>/v1/draft`             `{projectId, questionId, revision, goal, deadline, answer}`
+//! * `POST <state>/v1/commit`            `{projectId, expectedVersion, business}`
+//!
+//! A draft is stored per project and question; only a larger `revision` may
+//! overwrite it. The business record names the current clarification question in
+//! its top-level `questionId` string; `GET` returns that question's draft and
+//! nothing else, so a new question whose revisions start low never returns the
+//! previous question's answer. Without a business record, or without a
+//! `questionId`, there is no current question and `draft` is `null`.
+//!
+//! A commit checks `expectedVersion` inside one transaction, rejects a stored
+//! record that is not valid JSON would be silently overwritten, increments the
+//! version, writes the whole business record, reads it back, and only then
+//! answers `{version, business}`.
+//!
+//! Storage is bounded by the app's whole `storage` grant. After the rows are
+//! written, but before the transaction commits, the service measures the jail
+//! as it will be: every file except the database itself (the old JSON records,
+//! anything the app wrote, the rollback journal) plus the database's actual
+//! page count (`PRAGMA page_count * PRAGMA page_size`). That reflects page,
+//! index and journal growth and never adds payload bytes the database already
+//! contains. A total above the quota rolls the transaction back. The request
+//! body itself is bounded by the same grant before it is buffered.
+//!
+//! On the first read the service migrates the app's old
+//! `calendar-a.json`/`calendar-b.json` records in one transaction. Every
+//! present file must parse, carry `payload == mirror`, `schema == 3` and a
+//! matching non-negative `sequence`; the two must not share a sequence with
+//! different content, and the record's `project.id` must equal the requested
+//! project. A failure stops the migration with no row written and the database
+//! left as it was. The migrated record drops the full `agent` model session and
+//! keeps the business fields and the resume material.
+
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::Duration;
+use tiny_http::{Header, Method, Response, Server};
+
+/// The SQLite file, inside the app's jail.
+pub const STATE_DB_FILE: &str = "state.sqlite3";
+/// The record format this host migrates and the version its own schema
+/// expects. Matches `bundle/main.splash` and `docs/PROTOCOL.md`.
+pub const LEGACY_SCHEMA_VERSION: i64 = 3;
+const LEGACY_FILES: [&str; 2] = ["calendar-a.json", "calendar-b.json"];
+/// Byte length of the random URL credential.
+const CREDENTIAL_BYTES: usize = 32;
+/// The largest request body buffered, regardless of how large the storage
+/// quota is. The quota still applies on top.
+const MAX_REQUEST_BYTES: u64 = 64 * 1024 * 1024;
+/// The business field naming the current clarification question.
+const CURRENT_QUESTION_FIELD: &str = "questionId";
+
+/// A running state service. Dropping it stops the worker and frees the port.
+pub struct StateService {
+    origin: String,
+    port: u16,
+    stop: Arc<AtomicBool>,
+}
+
+impl StateService {
+    /// Start the service for a jail. The caller only calls this for an app
+    /// that was granted `storage`. `quota_bytes` is the whole jail's ceiling;
+    /// zero means no write is accepted.
+    pub fn start(jail_root: &Path, quota_bytes: u64) -> Result<StateService, String> {
+        std::fs::create_dir_all(jail_root)
+            .map_err(|e| format!("state service: cannot make {}: {e}", jail_root.display()))?;
+        let store = Store::open(jail_root, quota_bytes)?;
+        let secret = random_credential()?;
+        let server = Server::http("127.0.0.1:0").map_err(|e| format!("state service: {e}"))?;
+        let port = server
+            .server_addr()
+            .to_ip()
+            .map(|addr| addr.port())
+            .ok_or_else(|| "state service: bound to no loopback address".to_string())?;
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = stop.clone();
+        let prefix = format!("/{secret}");
+        std::thread::Builder::new()
+            .name("app-state".into())
+            .spawn(move || run(server, store, prefix, flag))
+            .map_err(|e| format!("state service: cannot start its worker: {e}"))?;
+        Ok(StateService {
+            origin: format!("http://127.0.0.1:{port}/{secret}"),
+            port,
+            stop,
+        })
+    }
+
+    /// The base URL a lowered app uses, with no trailing slash.
+    pub fn origin(&self) -> &str {
+        &self.origin
+    }
+
+    /// Exactly this service and no other loopback endpoint.
+    pub fn allowlist_entry(&self) -> String {
+        format!("127.0.0.1:{}", self.port)
+    }
+}
+
+impl Drop for StateService {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+    }
+}
+
+fn random_credential() -> Result<String, String> {
+    use rand_core::TryRngCore;
+    let mut bytes = [0u8; CREDENTIAL_BYTES];
+    rand_core::OsRng
+        .try_fill_bytes(&mut bytes)
+        .map_err(|e| format!("state service: the OS has no randomness: {e}"))?;
+    Ok(hex::encode(bytes))
+}
+
+fn run(server: Server, mut store: Store, prefix: String, stop: Arc<AtomicBool>) {
+    while !stop.load(Ordering::Relaxed) {
+        match server.recv_timeout(Duration::from_millis(100)) {
+            Ok(Some(request)) => {
+                let _ = answer(&mut store, &prefix, request);
+            }
+            Ok(None) => {}
+            Err(_) => break,
+        }
+    }
+}
+
+fn answer(
+    store: &mut Store,
+    prefix: &str,
+    mut request: tiny_http::Request,
+) -> std::io::Result<()> {
+    let method = request.method().clone();
+    let url = request.url().to_string();
+    // Bound the body before buffering it: a hostile client must not be able to
+    // make the host allocate without limit. `.take` reads at most one byte past
+    // the bound so an over-long body is recognised without being stored.
+    let limit = store.request_limit();
+    let mut bytes = Vec::new();
+    let mut limited = std::io::Read::take(request.as_reader(), limit.saturating_add(1));
+    std::io::Read::read_to_end(&mut limited, &mut bytes)?;
+    let reply = if bytes.len() as u64 > limit {
+        Reply::error(413, "the request body exceeds the app's storage quota")
+    } else {
+        match String::from_utf8(bytes) {
+            Ok(body) => route(store, prefix, &method, &url, &body),
+            Err(_) => Reply::error(400, "the request body is not UTF-8"),
+        }
+    };
+    let header = Header::from_bytes(&b"Content-Type"[..], &b"application/json"[..])
+        .expect("a static header is valid");
+    request.respond(
+        Response::from_string(reply.body.to_string())
+            .with_status_code(reply.status)
+            .with_header(header),
+    )
+}
+
+struct Reply {
+    status: u16,
+    body: Value,
+}
+
+impl Reply {
+    fn ok(body: Value) -> Reply {
+        Reply { status: 200, body }
+    }
+
+    fn error(status: u16, message: impl Into<String>) -> Reply {
+        Reply { status, body: json!({"error": message.into()}) }
+    }
+}
+
+fn route(store: &mut Store, prefix: &str, method: &Method, url: &str, body: &str) -> Reply {
+    let (path, query) = match url.split_once('?') {
+        Some((path, query)) => (path, query),
+        None => (url, ""),
+    };
+    let Some(rest) = path.strip_prefix(prefix) else {
+        return Reply::error(404, "not found");
+    };
+    match (method, rest) {
+        (Method::Get, "/v1/state") => get_state(store, query),
+        (Method::Post, "/v1/draft") => post_draft(store, body),
+        (Method::Post, "/v1/commit") => post_commit(store, body),
+        _ => Reply::error(404, "not found"),
+    }
+}
+
+fn query_param(query: &str, name: &str) -> Option<String> {
+    query.split('&').find_map(|pair| {
+        let (key, value) = pair.split_once('=')?;
+        (key == name).then(|| value.to_string())
+    })
+}
+
+fn get_state(store: &mut Store, query: &str) -> Reply {
+    let Some(project_id) = query_param(query, "projectId").filter(|id| !id.is_empty()) else {
+        return Reply::error(400, "projectId is required");
+    };
+    match store.state(&project_id) {
+        Ok(body) => Reply::ok(body),
+        Err(error) => store_error(error),
+    }
+}
+
+fn post_draft(store: &mut Store, body: &str) -> Reply {
+    let Some(value) = parse_body(body) else {
+        return Reply::error(400, "the request body is not a JSON object");
+    };
+    let project_id = match required_string(&value, "projectId") {
+        Ok(value) => value,
+        Err(reply) => return reply,
+    };
+    let question_id = match required_string(&value, "questionId") {
+        Ok(value) => value,
+        Err(reply) => return reply,
+    };
+    let goal = match required_string(&value, "goal") {
+        Ok(value) => value,
+        Err(reply) => return reply,
+    };
+    let deadline = match required_string(&value, "deadline") {
+        Ok(value) => value,
+        Err(reply) => return reply,
+    };
+    let answer = match required_string(&value, "answer") {
+        Ok(value) => value,
+        Err(reply) => return reply,
+    };
+    let Some(revision) = value.get("revision").and_then(Value::as_i64).filter(|r| *r >= 0) else {
+        return Reply::error(400, "revision must be a non-negative integer");
+    };
+    match store.put_draft(&project_id, &question_id, revision, &goal, &deadline, &answer) {
+        Ok(body) => Reply::ok(body),
+        Err(error) => store_error(error),
+    }
+}
+
+fn post_commit(store: &mut Store, body: &str) -> Reply {
+    let Some(value) = parse_body(body) else {
+        return Reply::error(400, "the request body is not a JSON object");
+    };
+    let project_id = match required_string(&value, "projectId") {
+        Ok(value) => value,
+        Err(reply) => return reply,
+    };
+    let Some(expected_version) = value.get("expectedVersion").and_then(Value::as_i64).filter(|v| *v >= 0)
+    else {
+        return Reply::error(400, "expectedVersion must be a non-negative integer");
+    };
+    let Some(business) = value.get("business") else {
+        return Reply::error(400, "business is required");
+    };
+    match store.commit(&project_id, expected_version, business.clone()) {
+        Ok(body) => Reply::ok(body),
+        Err(error) => store_error(error),
+    }
+}
+
+fn parse_body(body: &str) -> Option<Value> {
+    let value: Value = serde_json::from_str(body).ok()?;
+    value.is_object().then_some(value)
+}
+
+/// A field the request must carry as a string. A missing or wrongly typed
+/// field is a client error, never a silently stored empty draft field.
+fn required_string(value: &Value, name: &str) -> Result<String, Reply> {
+    match value.get(name) {
+        Some(Value::String(text)) => Ok(text.clone()),
+        Some(_) => Err(Reply::error(400, format!("{name} must be a string"))),
+        None => Err(Reply::error(400, format!("{name} is required"))),
+    }
+}
+
+fn store_error(error: StoreError) -> Reply {
+    match error {
+        StoreError::Conflict { version } => Reply {
+            status: 409,
+            body: json!({"error": "version_conflict", "version": version}),
+        },
+        StoreError::Quota(message) => Reply::error(507, message),
+        StoreError::Migration(message) => Reply::error(500, message),
+        StoreError::Internal(message) => Reply::error(500, message),
+    }
+}
+
+/// A failure the service turns into an HTTP status.
+#[derive(Debug)]
+enum StoreError {
+    Conflict { version: i64 },
+    Quota(String),
+    Migration(String),
+    Internal(String),
+}
+
+impl From<rusqlite::Error> for StoreError {
+    fn from(error: rusqlite::Error) -> Self {
+        StoreError::Internal(format!("state database: {error}"))
+    }
+}
+
+/// The worker's SQLite handle, its quota and where its legacy records live.
+struct Store {
+    conn: Connection,
+    jail_root: PathBuf,
+    quota: u64,
+    migrated: bool,
+}
+
+impl Store {
+    fn open(jail_root: &Path, quota: u64) -> Result<Store, String> {
+        let db_path = jail_root.join(STATE_DB_FILE);
+        let conn = Connection::open(&db_path)
+            .map_err(|e| format!("state service: cannot open {}: {e}", db_path.display()))?;
+        // Fail fast rather than stall a UI thread when another writer holds
+        // the file; the commit answers an error and leaves the record alone.
+        conn.busy_timeout(Duration::from_millis(0))
+            .map_err(|e| format!("state service: busy timeout: {e}"))?;
+        conn.execute_batch(
+            "CREATE TABLE IF NOT EXISTS business (
+                 project_id TEXT PRIMARY KEY,
+                 version    INTEGER NOT NULL,
+                 business   TEXT
+             );
+             CREATE TABLE IF NOT EXISTS draft (
+                 project_id  TEXT NOT NULL,
+                 question_id TEXT NOT NULL,
+                 revision    INTEGER NOT NULL,
+                 goal        TEXT NOT NULL DEFAULT '',
+                 deadline    TEXT NOT NULL DEFAULT '',
+                 answer      TEXT NOT NULL DEFAULT '',
+                 PRIMARY KEY (project_id, question_id)
+             );
+             CREATE TABLE IF NOT EXISTS meta (
+                 key   TEXT PRIMARY KEY,
+                 value TEXT NOT NULL
+             );",
+        )
+        .map_err(|e| format!("state service: cannot create its tables: {e}"))?;
+        Ok(Store {
+            conn,
+            jail_root: jail_root.to_path_buf(),
+            quota,
+            migrated: false,
+        })
+    }
+
+    /// The largest request body the service buffers, tied to the grant.
+    fn request_limit(&self) -> u64 {
+        self.quota.min(MAX_REQUEST_BYTES)
+    }
+
+    /// Reject the current transaction when the jail as it stands would pass
+    /// the quota. Called after the rows are written and before commit, so the
+    /// database's live page count is part of the measurement.
+    fn check_quota(jail_root: &Path, quota: u64, tx: &Connection) -> Result<(), StoreError> {
+        let total = jail_bytes_except_db(jail_root)?.saturating_add(db_page_bytes(tx)?);
+        if quota != 0 && total <= quota {
+            return Ok(());
+        }
+        Err(StoreError::Quota(format!(
+            "the app's storage quota is exceeded: {total} bytes occupied, {quota} allowed"
+        )))
+    }
+
+    fn meta_flag(&self, key: &str) -> rusqlite::Result<bool> {
+        self.conn
+            .query_row("SELECT value FROM meta WHERE key = ?1", params![key], |row| {
+                row.get::<_, String>(0)
+            })
+            .optional()
+            .map(|value| value.is_some())
+    }
+
+    /// Migrate the app's old JSON records once, into `project_id`.
+    fn ensure_migrated(&mut self, project_id: &str) -> Result<(), StoreError> {
+        if self.migrated {
+            return Ok(());
+        }
+        if self.meta_flag("migrated")? {
+            self.migrated = true;
+            return Ok(());
+        }
+        // Read and validate before touching the database, so a corrupt file
+        // never even opens a write transaction.
+        let business = read_legacy(&self.jail_root).map_err(StoreError::Migration)?;
+        let tx = self.conn.transaction()?;
+        if let Some(business) = business {
+            let record_project = business
+                .get("project")
+                .and_then(|project| project.get("id"))
+                .and_then(Value::as_str)
+                .ok_or_else(|| {
+                    StoreError::Migration(
+                        "the legacy record has no project id to check its migration against".into(),
+                    )
+                })?;
+            if record_project != project_id {
+                return Err(StoreError::Migration(format!(
+                    "the legacy record belongs to project {record_project:?}, not {project_id:?}"
+                )));
+            }
+            let text = business.to_string();
+            tx.execute(
+                "INSERT INTO business(project_id, version, business) VALUES(?1, 0, ?2)
+                 ON CONFLICT(project_id) DO UPDATE SET version = excluded.version, business = excluded.business",
+                params![project_id, text],
+            )?;
+        }
+        tx.execute(
+            "INSERT INTO meta(key, value) VALUES('migrated', '1')
+             ON CONFLICT(key) DO UPDATE SET value = '1'",
+            [],
+        )?;
+        Self::check_quota(&self.jail_root, self.quota, &tx)?;
+        tx.commit()?;
+        self.migrated = true;
+        Ok(())
+    }
+
+    fn state(&mut self, project_id: &str) -> Result<Value, StoreError> {
+        self.ensure_migrated(project_id)?;
+        let row: Option<(i64, Option<String>)> = self
+            .conn
+            .query_row(
+                "SELECT version, business FROM business WHERE project_id = ?1",
+                params![project_id],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .optional()?;
+        let (version, business_text) = row.unwrap_or((0, None));
+        let business = match &business_text {
+            None => Value::Null,
+            Some(text) => serde_json::from_str(text).map_err(|e| {
+                StoreError::Internal(format!(
+                    "state database: the stored business record is not valid JSON: {e}"
+                ))
+            })?,
+        };
+        // Only the current question's draft is returned. A stored but
+        // non-string `questionId` is corruption, not "no question".
+        let draft = match business.get(CURRENT_QUESTION_FIELD) {
+            None => Value::Null,
+            Some(Value::String(question_id)) => self.draft(project_id, question_id)?,
+            Some(_) => {
+                return Err(StoreError::Internal(format!(
+                    "state database: {CURRENT_QUESTION_FIELD} is not a string"
+                )))
+            }
+        };
+        Ok(json!({
+            "version": version,
+            "business": business,
+            "draft": draft,
+        }))
+    }
+
+    fn draft(&self, project_id: &str, question_id: &str) -> Result<Value, StoreError> {
+        let draft: Option<Value> = self
+            .conn
+            .query_row(
+                "SELECT revision, goal, deadline, answer FROM draft
+                 WHERE project_id = ?1 AND question_id = ?2",
+                params![project_id, question_id],
+                |row| {
+                    Ok(json!({
+                        "questionId": question_id,
+                        "revision": row.get::<_, i64>(0)?,
+                        "goal": row.get::<_, String>(1)?,
+                        "deadline": row.get::<_, String>(2)?,
+                        "answer": row.get::<_, String>(3)?,
+                    }))
+                },
+            )
+            .optional()?;
+        Ok(draft.unwrap_or(Value::Null))
+    }
+
+    fn put_draft(
+        &mut self,
+        project_id: &str,
+        question_id: &str,
+        revision: i64,
+        goal: &str,
+        deadline: &str,
+        answer: &str,
+    ) -> Result<Value, StoreError> {
+        self.ensure_migrated(project_id)?;
+        let tx = self.conn.transaction()?;
+        let existing: Option<i64> = tx
+            .query_row(
+                "SELECT revision FROM draft WHERE project_id = ?1 AND question_id = ?2",
+                params![project_id, question_id],
+                |row| row.get(0),
+            )
+            .optional()?;
+        let applied = existing.is_none_or(|current| revision > current);
+        if applied {
+            tx.execute(
+                "INSERT INTO draft(project_id, question_id, revision, goal, deadline, answer)
+                 VALUES(?1, ?2, ?3, ?4, ?5, ?6)
+                 ON CONFLICT(project_id, question_id) DO UPDATE SET
+                     revision = excluded.revision,
+                     goal = excluded.goal,
+                     deadline = excluded.deadline,
+                     answer = excluded.answer
+                 WHERE excluded.revision > draft.revision",
+                params![project_id, question_id, revision, goal, deadline, answer],
+            )?;
+            Self::check_quota(&self.jail_root, self.quota, &tx)?;
+        }
+        let current: i64 = tx
+            .query_row(
+                "SELECT revision FROM draft WHERE project_id = ?1 AND question_id = ?2",
+                params![project_id, question_id],
+                |row| row.get(0),
+            )
+            .optional()?
+            .unwrap_or(revision);
+        tx.commit()?;
+        Ok(json!({"applied": applied, "revision": current}))
+    }
+
+    fn commit(
+        &mut self,
+        project_id: &str,
+        expected_version: i64,
+        business: Value,
+    ) -> Result<Value, StoreError> {
+        self.ensure_migrated(project_id)?;
+        let tx = self.conn.transaction()?;
+        let existing: Option<(i64, Option<String>)> = tx
+            .query_row(
+                "SELECT version, business FROM business WHERE project_id = ?1",
+                params![project_id],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .optional()?;
+        let current = existing.as_ref().map(|(version, _)| *version).unwrap_or(0);
+        if current != expected_version {
+            return Err(StoreError::Conflict { version: current });
+        }
+        // A stored record that no longer parses is corruption. Refuse rather
+        // than let a new record silently replace it.
+        if let Some(text) = existing.and_then(|(_, business)| business) {
+            serde_json::from_str::<Value>(&text).map_err(|e| {
+                StoreError::Internal(format!(
+                    "state database: the stored business record is not valid JSON: {e}"
+                ))
+            })?;
+        }
+        let text = business.to_string();
+        let next_version = current + 1;
+        tx.execute(
+            "INSERT INTO business(project_id, version, business) VALUES(?1, ?2, ?3)
+             ON CONFLICT(project_id) DO UPDATE SET version = excluded.version, business = excluded.business",
+            params![project_id, next_version, text],
+        )?;
+        Self::check_quota(&self.jail_root, self.quota, &tx)?;
+        // Read the just-written record back inside the same transaction: the
+        // answer is only returned when the stored bytes are what was sent.
+        let row: Option<(i64, Option<String>)> = tx
+            .query_row(
+                "SELECT version, business FROM business WHERE project_id = ?1",
+                params![project_id],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .optional()?;
+        let (version, stored_text) = row.ok_or_else(|| {
+            StoreError::Internal("state database: the committed record vanished before read-back".into())
+        })?;
+        let stored_text = stored_text.ok_or_else(|| {
+            StoreError::Internal("state database: the committed record has no body".into())
+        })?;
+        let read_back: Value = serde_json::from_str(&stored_text).map_err(|e| {
+            StoreError::Internal(format!("state database: stored JSON is invalid: {e}"))
+        })?;
+        if read_back != business {
+            return Err(StoreError::Internal(
+                "state database: the read-back record differs from the committed one".into(),
+            ));
+        }
+        tx.commit()?;
+        Ok(json!({"version": version, "business": read_back}))
+    }
+}
+
+/// Bytes already occupied by everything in the jail: the SQLite file, the old
+/// JSON records and anything else the app wrote. Used by the tests to measure
+/// a quota baseline; the live check is [`jail_bytes_except_db`] plus the
+/// database's page count.
+#[cfg(test)]
+fn jail_used(jail_root: &Path) -> Result<u64, StoreError> {
+    fn walk(dir: &Path, total: &mut u64) -> std::io::Result<()> {
+        for entry in std::fs::read_dir(dir)? {
+            let entry = entry?;
+            let metadata = entry.metadata()?;
+            if metadata.is_dir() {
+                walk(&entry.path(), total)?;
+            } else {
+                *total = total.saturating_add(metadata.len());
+            }
+        }
+        Ok(())
+    }
+    let mut total = 0;
+    walk(jail_root, &mut total)
+        .map_err(|e| StoreError::Internal(format!("state service: cannot measure the jail: {e}")))?;
+    Ok(total)
+}
+
+/// The database's actual size in the current transaction, including pages the
+/// uncommitted writes have allocated. `PRAGMA page_count` is the pager's live
+/// size, so it reflects page, index and overflow growth before commit.
+fn db_page_bytes(conn: &Connection) -> Result<u64, StoreError> {
+    let page_size: i64 = conn.query_row("PRAGMA page_size", [], |row| row.get(0))?;
+    let page_count: i64 = conn.query_row("PRAGMA page_count", [], |row| row.get(0))?;
+    Ok((page_size.max(0) as u64).saturating_mul(page_count.max(0) as u64))
+}
+
+/// Every file in the jail except the database file itself: the old JSON
+/// records, the app's own files and the rollback journal. The database's own
+/// bytes come from [`db_page_bytes`], so payload is never counted twice.
+fn jail_bytes_except_db(jail_root: &Path) -> Result<u64, StoreError> {
+    let db_path = jail_root.join(STATE_DB_FILE);
+    fn walk(dir: &Path, db: &Path, total: &mut u64) -> std::io::Result<()> {
+        for entry in std::fs::read_dir(dir)? {
+            let entry = entry?;
+            let path = entry.path();
+            let metadata = entry.metadata()?;
+            if metadata.is_dir() {
+                walk(&path, db, total)?;
+            } else if path != db {
+                *total = total.saturating_add(metadata.len());
+            }
+        }
+        Ok(())
+    }
+    let mut total = 0;
+    walk(jail_root, &db_path, &mut total).map_err(|e| {
+        StoreError::Internal(format!("state service: cannot measure the jail: {e}"))
+    })?;
+    Ok(total)
+}
+
+/// Read and validate both legacy files, returning the newest migrated
+/// business record with the model session dropped.
+fn read_legacy(jail_root: &Path) -> Result<Option<Value>, String> {
+    let mut records: HashMap<&str, (i64, Value)> = HashMap::new();
+    for name in LEGACY_FILES {
+        let path = jail_root.join(name);
+        if !path.exists() {
+            continue;
+        }
+        records.insert(name, read_record(&path)?);
+    }
+    let business = match (records.remove("calendar-a.json"), records.remove("calendar-b.json")) {
+        (None, None) => return Ok(None),
+        (Some(record), None) | (None, Some(record)) => record,
+        (Some((first_seq, first)), Some((second_seq, second))) => {
+            if first_seq > second_seq {
+                (first_seq, first)
+            } else if second_seq > first_seq {
+                (second_seq, second)
+            } else if first == second {
+                (first_seq, first)
+            } else {
+                return Err(format!(
+                    "calendar-a.json and calendar-b.json share sequence {first_seq} with different content"
+                ));
+            }
+        }
+    };
+    let (_, mut record) = business;
+    if let Some(object) = record.as_object_mut() {
+        // The full model session is the server's, not the host's business
+        // record; the resume material stays in the business fields.
+        object.remove("agent");
+    }
+    Ok(Some(record))
+}
+
+fn read_record(path: &Path) -> Result<(i64, Value), String> {
+    let text = std::fs::read_to_string(path)
+        .map_err(|e| format!("{}: {e}", path.display()))?;
+    let envelope: Value =
+        serde_json::from_str(&text).map_err(|e| format!("{}: not JSON: {e}", path.display()))?;
+    let envelope = envelope
+        .as_object()
+        .ok_or_else(|| format!("{}: the record envelope is not an object", path.display()))?;
+    let payload = envelope
+        .get("payload")
+        .and_then(Value::as_str)
+        .ok_or_else(|| format!("{}: payload is missing", path.display()))?;
+    let mirror = envelope
+        .get("mirror")
+        .and_then(Value::as_str)
+        .ok_or_else(|| format!("{}: mirror is missing", path.display()))?;
+    if payload != mirror {
+        return Err(format!("{}: payload and mirror differ", path.display()));
+    }
+    let outer_sequence = envelope
+        .get("sequence")
+        .and_then(Value::as_i64)
+        .ok_or_else(|| format!("{}: sequence is missing", path.display()))?;
+    let record: Value =
+        serde_json::from_str(payload).map_err(|e| format!("{}: payload is not JSON: {e}", path.display()))?;
+    let record = record
+        .as_object()
+        .ok_or_else(|| format!("{}: the record is not an object", path.display()))?;
+    let schema = record
+        .get("schema")
+        .and_then(Value::as_i64)
+        .ok_or_else(|| format!("{}: schema is missing", path.display()))?;
+    if schema != LEGACY_SCHEMA_VERSION {
+        return Err(format!(
+            "{}: schema {schema} is not version {LEGACY_SCHEMA_VERSION}",
+            path.display()
+        ));
+    }
+    let sequence = record
+        .get("sequence")
+        .and_then(Value::as_i64)
+        .filter(|s| *s >= 0)
+        .ok_or_else(|| format!("{}: sequence is missing or negative", path.display()))?;
+    if sequence != outer_sequence {
+        return Err(format!(
+            "{}: the record's sequence {sequence} does not match the envelope's {outer_sequence}",
+            path.display()
+        ));
+    }
+    Ok((sequence, Value::Object(record.clone())))
+}
