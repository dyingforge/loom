+    #[test]
+    fn a_locked_database_aborts_the_commit_without_changing_it() {
+        let jail = test_jail("locked");
+        let service = StateService::start(&jail, 1 << 20).unwrap();
+        let base = service.origin();
+
+        let (status, _) = post(
+            base,
+            "/v1/commit",
+            &json!({"projectId": "loom", "expectedVersion": 0, "business": {"n": 1}}),
+        );
+        assert_eq!(status, 200);
+
+        // A second real connection holds an exclusive transaction, exactly as
+        // a crash or another writer would mid-commit.
+        let blocker = Connection::open(jail.join(STATE_DB_FILE)).unwrap();
+        blocker.execute_batch("BEGIN EXCLUSIVE").unwrap();
+        let (status, body) = post(
+            base,
+            "/v1/commit",
+            &json!({"projectId": "loom", "expectedVersion": 1, "business": {"n": 2}}),
+        );
+        assert_ne!(status, 200, "the locked commit must fail: {body}");
+        blocker.execute_batch("ROLLBACK").unwrap();
+
+        let (_, state) = get(base, "/v1/state?projectId=loom");
+        assert_eq!(state["version"], 1);
+        assert_eq!(state["business"], json!({"n": 1}));
+
+        // Once the lock is gone the same commit succeeds.
+        let (status, body) = post(
+            base,
+            "/v1/commit",
+            &json!({"projectId": "loom", "expectedVersion": 1, "business": {"n": 2}}),
+        );
+        assert_eq!(status, 200, "{body}");
+        assert_eq!(body["version"], 2);
+    }
