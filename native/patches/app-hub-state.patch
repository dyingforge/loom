+    /// Test databases live under the workspace `target/` directory, which the
+    /// repository already ignores; nothing is written to a system temporary
+    /// directory.
+    fn test_jail(tag: &str) -> PathBuf {
+        let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../target/card-host-state-tests")
+            .join(format!("{}-{tag}-{}", std::process::id(), NEXT_JAIL.fetch_add(1, Ordering::Relaxed)));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).expect("test jail");
+        dir
+    }
+
+    /// The steady jail size after the one-time migration bookkeeping: the
+    /// quota baseline a test measures against.
+    fn steady_jail_bytes(jail: &Path) -> u64 {
+        let probe = StateService::start(jail, 64 * 1024 * 1024).expect("probe service");
+        let (status, body) = get(probe.origin(), "/v1/state?projectId=__measure__");
+        assert_eq!(status, 200, "{body}");
+        drop(probe);
+        jail_used(jail).expect("measure jail")
+    }
+
+    /// Start a service whose quota is measured from the real jail, so the
+    /// test never assumes a quota below the database's own size.
+    fn start_with_allowance(jail: &Path, allowance: u64) -> StateService {
+        StateService::start(jail, steady_jail_bytes(jail) + allowance)
+            .expect("service with a measured quota")
+    }
+
+    fn agent() -> ureq::Agent {
+        ureq::Agent::config_builder()
+            .http_status_as_error(false)
+            .timeout_global(Some(Duration::from_secs(10)))
+            .build()
+            .new_agent()
+    }
+
+    fn get(base: &str, path: &str) -> (u16, Value) {
+        let mut response = agent()
+            .get(&format!("{base}{path}"))
+            .call()
+            .expect("GET reaches the state service");
+        let status = response.status().as_u16();
+        let text = response
+            .body_mut()
+            .with_config()
+            .limit(1 << 20)
+            .read_to_string()
+            .expect("response body");
+        (status, serde_json::from_str(&text).unwrap_or(Value::Null))
+    }
+
+    fn post_raw(base: &str, path: &str, body: &str) -> (u16, Value) {
+        let mut response = agent()
+            .post(&format!("{base}{path}"))
+            .header("Content-Type", "application/json")
+            .send(body)
+            .expect("POST reaches the state service");
+        let status = response.status().as_u16();
+        let text = response
+            .body_mut()
+            .with_config()
+            .limit(1 << 20)
+            .read_to_string()
+            .expect("response body");
+        (status, serde_json::from_str(&text).unwrap_or(Value::Null))
+    }
+
+    fn post(base: &str, path: &str, body: &Value) -> (u16, Value) {
+        post_raw(base, path, &body.to_string())
+    }
+
+    fn legacy_envelope(schema: i64, sequence: i64, project: &str) -> String {
+        let record = json!({
+            "schema": schema,
+            "sequence": sequence,
+            "project": {"id": project, "version": 0},
+            "agent": {"session": "the whole model conversation"},
+        })
+        .to_string();
+        json!({"sequence": sequence, "payload": record, "mirror": record}).to_string()
+    }
