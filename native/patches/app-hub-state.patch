+    fn repeated_updates_never_exceed_the_quota() {
+        let jail = test_jail("quota-repeat");
+        let quota = steady_jail_bytes(&jail) + 16 * 1024;
+        let service = StateService::start(&jail, quota).unwrap();
+        let base = service.origin();
+        let mut accepted = 0;
+        for step in 0..8 {
+            let text = if step % 2 == 0 { "x".repeat(4096) } else { "y".repeat(64) };
+            let (status, body) = post(
+                base,
+                "/v1/commit",
+                &json!({"projectId": "loom", "expectedVersion": accepted,
+                        "business": {"step": step, "text": text}}),
+            );
+            assert!(
+                status == 200 || status == 507,
+                "unexpected status {status} at step {step}: {body}"
+            );
+            if status == 200 {
+                accepted += 1;
+            }
+            // However the writes went, the jail never sits above the quota.
+            assert!(
+                jail_used(&jail).unwrap() <= quota,
+                "the jail grew past its quota at step {step}"
+            );
+        }
+        let (_, state) = get(base, "/v1/state?projectId=loom");
+        assert_eq!(state["version"], json!(accepted));
+    }
