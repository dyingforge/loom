+            .next()
+            .unwrap();
+        let (status, _) = get(&format!("http://127.0.0.1:{port}"), "/wrong/v1/state?projectId=loom");
+        assert_eq!(status, 404);
+        let (status, _) = get(origin, "/v1/unknown");
+        assert_eq!(status, 404);
+    }
+}
